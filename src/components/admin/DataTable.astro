---
// src/components/admin/DataTable.astro

export interface Column {
  key: string
  label: string
  format?: (value: unknown, row: Record<string, unknown>) => string
  class?: string
}

interface Props {
  columns: Column[]
  rows: Record<string, unknown>[]
  idField?: string
  detailBase?: string
  page?: number
  total?: number
  pageSize?: number
  emptyMessage?: string
}

const {
  columns,
  rows,
  idField = 'id',
  detailBase,
  page = 1,
  total = 0,
  pageSize = 25,
  emptyMessage = 'Nessun risultato.',
} = Astro.props

const totalPages = pageSize > 0 ? Math.ceil(total / pageSize) : 1

// Build pagination URLs based on the current request URL
const currentUrl = new URL(Astro.request.url)

function buildPageUrl(targetPage: number): string {
  const url = new URL(currentUrl.toString())
  url.searchParams.set('page', String(targetPage))
  return url.pathname + url.search
}

const prevUrl = page > 1 ? buildPageUrl(page - 1) : null
const nextUrl = page < totalPages ? buildPageUrl(page + 1) : null

// Total number of visible columns (including optional detail column)
const colSpan = columns.length + (detailBase ? 1 : 0)
---

<div class="dt-wrapper">
  <div class="dt-scroll">
    <table class="dt-table">
      <thead>
        <tr>
          {columns.map((col) => (
            <th class={`dt-th${col.class ? ' ' + col.class : ''}`}>
              {col.label}
            </th>
          ))}
          {detailBase && <th class="dt-th dt-th-action"></th>}
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr>
            <td class="dt-empty" colspan={colSpan}>
              {emptyMessage}
            </td>
          </tr>
        ) : (
          rows.map((row) => (
            <tr class="dt-row">
              {columns.map((col) => {
                const raw = row[col.key]
                const html = col.format ? col.format(raw, row) : null
                return (
                  <td class={`dt-td${col.class ? ' ' + col.class : ''}`}>
                    {html !== null
                      ? <span set:html={html} />
                      : (raw !== null && raw !== undefined ? String(raw) : '')}
                  </td>
                )
              })}
              {detailBase && (
                <td class="dt-td dt-td-action">
                  <a
                    href={`${detailBase}${String(row[idField] ?? '')}`}
                    class="dt-link"
                    aria-label="Dettaglio"
                  >
                    →
                  </a>
                </td>
              )}
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  {totalPages > 1 && (
    <nav class="dt-pagination" aria-label="Paginazione">
      {prevUrl ? (
        <a href={prevUrl} class="dt-page-btn">← Precedente</a>
      ) : (
        <span class="dt-page-btn dt-page-btn--disabled">← Precedente</span>
      )}

      <span class="dt-page-info">
        Pagina {page} di {totalPages}
      </span>

      {nextUrl ? (
        <a href={nextUrl} class="dt-page-btn">Successiva →</a>
      ) : (
        <span class="dt-page-btn dt-page-btn--disabled">Successiva →</span>
      )}
    </nav>
  )}
</div>

<style>
  .dt-wrapper {
    width: 100%;
    font-size: 0.875rem;
  }

  /* Horizontal scroll container */
  .dt-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
  }

  .dt-table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
    background-color: #ffffff;
  }

  /* Header */
  .dt-th {
    padding: 0.625rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
    background-color: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  .dt-th-action {
    width: 3rem;
    text-align: center;
  }

  /* Body rows */
  .dt-row {
    border-bottom: 1px solid #f3f4f6;
    transition: background-color 0.15s ease;
  }

  .dt-row:last-child {
    border-bottom: none;
  }

  .dt-row:hover {
    background-color: #f9fafb;
  }

  .dt-td {
    padding: 0.75rem 1rem;
    color: #111827;
    vertical-align: middle;
  }

  .dt-td-action {
    text-align: center;
    padding: 0.75rem 0.5rem;
  }

  /* Detail link */
  .dt-link {
    display: inline-block;
    font-size: 1rem;
    color: #6b7280;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .dt-link:hover {
    color: #111827;
    background-color: #e5e7eb;
  }

  /* Empty state */
  .dt-empty {
    padding: 2.5rem 1rem;
    text-align: center;
    color: #9ca3af;
    font-style: italic;
  }

  /* Pagination */
  .dt-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0 0.25rem;
  }

  .dt-page-btn {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #374151;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .dt-page-btn:hover {
    background-color: #f9fafb;
    border-color: #9ca3af;
  }

  .dt-page-btn--disabled {
    color: #d1d5db;
    cursor: not-allowed;
    background-color: #f9fafb;
  }

  .dt-page-btn--disabled:hover {
    background-color: #f9fafb;
    border-color: #d1d5db;
  }

  .dt-page-info {
    font-size: 0.8125rem;
    color: #6b7280;
  }
</style>
