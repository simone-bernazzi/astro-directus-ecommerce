---
export interface Column {
  key: string
  label: string
  format?: (value: unknown, row: Record<string, unknown>) => string
  class?: string
}

interface Props {
  columns: Column[]
  rows: Record<string, unknown>[]
  idField?: string
  detailBase?: string
  page?: number
  total?: number
  pageSize?: number
  emptyMessage?: string
}

const {
  columns,
  rows,
  idField = 'id',
  detailBase,
  page = 1,
  total = 0,
  pageSize = 25,
  emptyMessage = 'Nessun risultato.',
} = Astro.props

const totalPages = pageSize > 0 ? Math.ceil(total / pageSize) : 1
const currentUrl = new URL(Astro.request.url)

function buildPageUrl(targetPage: number): string {
  const url = new URL(currentUrl.toString())
  url.searchParams.set('page', String(targetPage))
  return url.pathname + url.search
}

const prevUrl = page > 1 ? buildPageUrl(page - 1) : null
const nextUrl = page < totalPages ? buildPageUrl(page + 1) : null
const colSpan = columns.length + (detailBase ? 1 : 0)
---

<div class="dt-wrapper">
  <div class="table-wrap">
    <table class="dt-table" aria-label="Tabella dati">
      <thead>
        <tr>
          {columns.map((col) => (
            <th class={`dt-th${col.class ? ' ' + col.class : ''}`} scope="col">
              {col.label}
            </th>
          ))}
          {detailBase && <th class="dt-th dt-th-action" scope="col"><span class="sr-only">Dettaglio</span></th>}
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr>
            <td class="dt-empty" colspan={colSpan}>
              {emptyMessage}
            </td>
          </tr>
        ) : (
          rows.map((row) => {
            const href = detailBase ? `${detailBase}${String(row[idField] ?? '')}` : undefined
            return (
            <tr class={`dt-row${href ? ' dt-row-link' : ''}`}>
              {columns.map((col) => {
                const raw = row[col.key]
                const html = col.format ? col.format(raw, row) : null
                const text = raw !== null && raw !== undefined ? String(raw) : '—'
                return (
                  <td class={`dt-td${col.class ? ' ' + col.class : ''}${href ? ' dt-td-linked' : ''}`}>
                    {href ? (
                      <a href={href} class="dt-cell-link">
                        {html !== null ? <span set:html={html} /> : text}
                      </a>
                    ) : (
                      html !== null ? <span set:html={html} /> : text
                    )}
                  </td>
                )
              })}
              {detailBase && (
                <td class="dt-td dt-td-action">
                  <a
                    href={`${detailBase}${String(row[idField] ?? '')}`}
                    class="dt-detail-link"
                    aria-label="Apri dettaglio"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </a>
                </td>
              )}
            </tr>
            )
          })
        )}
      </tbody>
    </table>
  </div>

  {(totalPages > 1 || total > 0) && (
    <div class="dt-pagination">
      <span class="dt-count">
        {total > 0 ? `${total} totali` : ''}
      </span>

      {totalPages > 1 && (
        <nav class="dt-nav" aria-label="Paginazione">
          {prevUrl ? (
            <a href={prevUrl} class="btn btn-secondary btn-sm">← Precedente</a>
          ) : (
            <span class="btn btn-secondary btn-sm" aria-disabled="true" style="opacity:0.4;pointer-events:none">← Precedente</span>
          )}

          <span class="dt-page-info">
            {page} / {totalPages}
          </span>

          {nextUrl ? (
            <a href={nextUrl} class="btn btn-secondary btn-sm">Successiva →</a>
          ) : (
            <span class="btn btn-secondary btn-sm" aria-disabled="true" style="opacity:0.4;pointer-events:none">Successiva →</span>
          )}
        </nav>
      )}
    </div>
  )}
</div>

<style>
  .dt-wrapper {
    width: 100%;
  }

  .dt-table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
    background: var(--c-surface);
    font-size: 14px;
  }

  .dt-th {
    padding: 10px 16px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: var(--c-ink-muted);
    background: var(--c-surface-2);
    border-bottom: 1px solid var(--c-border);
  }

  .dt-th-action {
    width: 48px;
    text-align: center;
  }

  .dt-row {
    border-bottom: 1px solid var(--c-border);
    transition: background 120ms ease;
  }

  .dt-row:last-child {
    border-bottom: none;
  }

  .dt-row-link:hover {
    background: color-mix(in oklch, var(--admin-accent) 4%, var(--c-surface));
  }

  /* Cells with links: remove padding so the <a> fills the whole cell */
  .dt-td {
    color: var(--c-ink);
    vertical-align: middle;
    padding: 12px 16px;
  }

  .dt-td-linked {
    padding: 0;
  }

  /* The link that fills the cell */
  .dt-cell-link {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .dt-td-action {
    text-align: center;
    padding: 8px;
  }

  .dt-detail-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--c-ink-subtle);
    border-radius: var(--r-sm);
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .dt-row-link:hover .dt-detail-link {
    color: var(--admin-accent);
  }

  .dt-empty {
    padding: 48px 24px;
    text-align: center;
    color: var(--c-ink-muted);
  }

  .dt-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    padding: 0 2px;
    flex-wrap: wrap;
  }

  .dt-count {
    font-size: 12px;
    color: var(--c-ink-muted);
  }

  .dt-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dt-page-info {
    font-size: 13px;
    color: var(--c-ink-muted);
    min-width: 48px;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
