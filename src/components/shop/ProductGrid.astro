---
// src/components/shop/ProductGrid.astro
import type { Product, ProductCategory } from '@/lib/types'
import ProductCard from './ProductCard.astro'

interface Props {
  products: Product[]
  categories?: ProductCategory[]
  activeCategorySlug?: string
  title?: string
}

const { products, categories, activeCategorySlug, title } = Astro.props

const analyticsItems = JSON.stringify(products.map((p, i) => ({
  item_id: String(p.id),
  item_name: p.name,
  item_category: p.category_id?.name ?? '',
  price: p.variants?.[0]?.price_override ?? p.base_price,
  index: i,
})))
const listName = title ?? (activeCategorySlug ? activeCategorySlug : 'negozio')
---

<section data-analytics-list={listName} data-analytics-items={analyticsItems}>
  {title && <h2 class="text-2xl font-bold mb-6" data-animate="fade-up">{title}</h2>}

  {categories && categories.length > 0 && (
    <div class="flex gap-3 mb-8 flex-wrap">
      <a
        href="/negozio"
        class:list={[
          'px-4 py-2 rounded-full text-sm font-medium transition-colors duration-200',
          !activeCategorySlug
            ? 'bg-[var(--color-brand)] text-white'
            : 'border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-brand)]',
        ]}
      >
        Tutti
      </a>
      {categories.map(cat => (
        <a
          href={`/negozio/${cat.slug}`}
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium transition-colors duration-200',
            activeCategorySlug === cat.slug
              ? 'bg-[var(--color-brand)] text-white'
              : 'border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-brand)]',
          ]}
        >
          {cat.name}
        </a>
      ))}
    </div>
  )}

  {products.length === 0
    ? <p class="text-[var(--color-muted)] py-12 text-center">Nessun prodotto trovato.</p>
    : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" data-animate="stagger">
        {products.map((p, i) => <ProductCard product={p} listName={listName} index={i} />)}
      </div>
    )
  }
</section>

<script>
  import { trackViewItemList } from '@/lib/analytics'
  const section = document.querySelector<HTMLElement>('[data-analytics-list]')
  if (section?.dataset.analyticsItems) {
    try {
      trackViewItemList(
        section.dataset.analyticsList ?? 'negozio',
        JSON.parse(section.dataset.analyticsItems),
      )
    } catch { /* ignore */ }
  }
</script>
