---
// src/components/shop/ProductCard.astro
import type { Product } from '@/lib/types'
import { getDirectusImageUrl } from '@/lib/directus'
import Badge from '@/components/ui/Badge.astro'

interface Props {
  product: Product
  listName?: string
  index?: number
}

const { product, listName = 'negozio', index = 0 } = Astro.props
const firstImageFile = product.images?.[0]?.directus_files_id
const firstImageId = typeof firstImageFile === 'string' ? firstImageFile : firstImageFile?.id ?? null
const imageUrl = getDirectusImageUrl(firstImageId, { width: 600, quality: 80 })

const activeVariants = product.variants?.filter(v => v.is_active) ?? []
const price = activeVariants[0]?.price_override ?? product.base_price
const isOutOfStock = activeVariants.length > 0 && activeVariants.every(v => v.stock_quantity === 0)
const isNew = product.featured
---

<article class="group relative rounded-lg overflow-hidden border border-[var(--color-border)] hover:shadow-md transition-shadow duration-300 bg-[var(--color-bg)]">

  <!-- Wishlist button -->
  <button
    type="button"
    class="wishlist-btn absolute top-2 right-2 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/80 backdrop-blur-sm shadow hover:bg-white transition-colors"
    data-product-id={String(product.id)}
    data-product-slug={product.slug}
    data-product-name={product.name}
    data-product-price={price}
    data-product-image={imageUrl ?? ''}
    data-product-category={product.category_id?.name ?? ''}
    aria-label="Aggiungi alla wishlist"
    aria-pressed="false"
  >
    <!-- outline heart (default) -->
    <svg class="heart-outline w-4 h-4 text-[var(--color-muted)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
    <!-- filled heart (in wishlist) -->
    <svg class="heart-filled w-4 h-4 text-red-500 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
    </svg>
  </button>

  <a
    href={`/negozio/${product.slug}`}
    class="block"
    data-analytics-item={JSON.stringify({ item_id: String(product.id), item_name: product.name, item_category: product.category_id?.name ?? '', price, index })}
    data-analytics-list={listName}
  >
    <div class="aspect-square bg-[var(--color-surface)] overflow-hidden">
      {imageUrl
        ? <img
            src={imageUrl}
            alt={product.name}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        : <div class="w-full h-full flex items-center justify-center text-[var(--color-muted)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
      }
    </div>

    <div class="p-4">
      {product.category_id && (
        <p class="text-xs text-[var(--color-muted)] mb-1">{product.category_id.name}</p>
      )}
      <h3 class="font-medium text-[var(--color-text)] leading-tight line-clamp-2">{product.name}</h3>

      <div class="flex items-center gap-2 mt-2">
        <span class="font-bold text-[var(--color-brand)]">€{price.toFixed(2)}</span>
        {product.compare_price && (
          <span class="text-sm text-[var(--color-muted)] line-through">€{product.compare_price.toFixed(2)}</span>
        )}
      </div>

      <div class="flex gap-2 mt-3 flex-wrap">
        {isOutOfStock && <Badge variant="error">Esaurito</Badge>}
        {isNew && !isOutOfStock && <Badge variant="info">In evidenza</Badge>}
        {product.type === 'digital' && <Badge variant="default">Digitale</Badge>}
      </div>
    </div>
  </a>
</article>

<script>
  import { trackSelectItem } from '@/lib/analytics'
  import { toggleWishlist, wishlistItems } from '@/stores/wishlist'

  // Analytics — select_item
  document.querySelectorAll<HTMLAnchorElement>('[data-analytics-item]').forEach(link => {
    link.addEventListener('click', () => {
      try {
        trackSelectItem(link.dataset.analyticsList ?? 'negozio', JSON.parse(link.dataset.analyticsItem!))
      } catch { /* ignore */ }
    })
  })

  // Wishlist buttons
  function syncWishlistButtons() {
    const items = wishlistItems.get()
    const ids = new Set(items.map(i => i.productId))
    document.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(btn => {
      const id = btn.dataset.productId!
      const active = ids.has(id)
      btn.querySelector('.heart-outline')?.classList.toggle('hidden', active)
      btn.querySelector('.heart-filled')?.classList.toggle('hidden', !active)
      btn.setAttribute('aria-pressed', String(active))
      btn.setAttribute('aria-label', active ? 'Rimuovi dalla wishlist' : 'Aggiungi alla wishlist')
    })
  }

  wishlistItems.subscribe(syncWishlistButtons)

  document.querySelectorAll<HTMLButtonElement>('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault()
      e.stopPropagation()
      toggleWishlist({
        productId: btn.dataset.productId!,
        productSlug: btn.dataset.productSlug!,
        productName: btn.dataset.productName!,
        price: parseFloat(btn.dataset.productPrice!),
        image: btn.dataset.productImage || null,
        categoryName: btn.dataset.productCategory ?? '',
      })
    })
  })
</script>
