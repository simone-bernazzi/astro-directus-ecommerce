---
// src/components/shop/CompareTray.astro — sticky tray + comparison modal
---

<!-- Tray -->
<div
  id="compare-tray"
  class="fixed bottom-0 left-0 right-0 z-40 translate-y-full transition-transform duration-300 ease-in-out"
  aria-live="polite"
>
  <div class="bg-[var(--color-bg)] border-t border-[var(--color-border)] shadow-xl">
    <div class="container flex items-center gap-4 py-3 flex-wrap">
      <!-- Slots -->
      <div id="compare-slots" class="flex gap-3 flex-1 flex-wrap"></div>

      <div class="flex items-center gap-3 ml-auto shrink-0">
        <button
          id="compare-clear"
          type="button"
          class="text-sm text-[var(--color-muted)] hover:text-[var(--color-brand)] transition-colors underline"
        >
          Svuota
        </button>
        <button
          id="compare-open"
          type="button"
          class="px-5 py-2 rounded-lg bg-[var(--color-brand)] text-white text-sm font-medium hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed"
          disabled
        >
          Confronta (<span id="compare-count">0</span>)
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div
  id="compare-modal"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Confronta prodotti"
>
  <div class="absolute inset-0 bg-black/50" id="compare-backdrop"></div>
  <div class="absolute inset-x-0 bottom-0 bg-[var(--color-bg)] rounded-t-2xl overflow-auto max-h-[90dvh] shadow-2xl">
    <div class="container py-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold">Confronta prodotti</h2>
        <button id="compare-close" type="button" class="p-2 hover:text-[var(--color-brand)] transition-colors" aria-label="Chiudi">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="compare-table" class="overflow-x-auto"></div>
    </div>
  </div>
</div>

<script>
  import { compareItems, removeFromCompare, clearCompare, MAX_COMPARE } from '@/stores/compare'
  import { formatPrice, selectedCurrency, exchangeRates } from '@/stores/currency'
  import type { CompareItem } from '@/stores/compare'

  const tray = document.getElementById('compare-tray')!
  const slots = document.getElementById('compare-slots')!
  const countEl = document.getElementById('compare-count')!
  const openBtn = document.getElementById('compare-open') as HTMLButtonElement
  const clearBtn = document.getElementById('compare-clear')!
  const modal = document.getElementById('compare-modal')!
  const tableEl = document.getElementById('compare-table')!

  function price(eur: number | null): string {
    if (eur == null) return '—'
    return formatPrice(eur, selectedCurrency.get(), exchangeRates.get())
  }

  function renderTray(items: CompareItem[]) {
    tray.classList.toggle('translate-y-full', items.length === 0)
    openBtn.disabled = items.length < 2
    countEl.textContent = String(items.length)

    slots.innerHTML = items.map(p => {
      const escapedName = p.name.replace(/&/g, '&amp;').replace(/"/g, '&quot;')
      const img = p.imageUrl
        ? `<img src="${p.imageUrl}" alt="${escapedName}" class="w-10 h-10 object-cover rounded shrink-0" />`
        : `<div class="w-10 h-10 rounded bg-[var(--color-surface)] shrink-0"></div>`
      return `<div class="flex items-center gap-2 border border-[var(--color-border)] rounded-lg px-3 py-2 bg-[var(--color-surface)] text-sm max-w-[180px]">
        ${img}
        <span class="truncate text-[var(--color-text)] flex-1">${escapedName}</span>
        <button type="button" data-remove="${p.id}" class="shrink-0 text-[var(--color-muted)] hover:text-red-500 transition-colors" aria-label="Rimuovi">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>`
    }).join('')

    // Empty slots
    const empty = MAX_COMPARE - items.length
    for (let i = 0; i < empty; i++) {
      slots.innerHTML += `<div class="flex items-center gap-2 border border-dashed border-[var(--color-border)] rounded-lg px-3 py-2 text-sm text-[var(--color-muted)] w-[160px]">+ Aggiungi prodotto</div>`
    }
  }

  function renderTable(items: CompareItem[]) {
    if (items.length === 0) { tableEl.innerHTML = ''; return }

    const rows: [string, string[]][] = [
      ['', items.map(p => {
        const img = p.imageUrl
          ? `<img src="${p.imageUrl}" alt="${p.name.replace(/&/g,'&amp;')}" class="w-full h-40 object-cover rounded-lg mb-3" />`
          : `<div class="w-full h-40 bg-[var(--color-surface)] rounded-lg mb-3"></div>`
        return `${img}<a href="/negozio/${p.slug}" class="font-semibold hover:text-[var(--color-brand)] transition-colors">${p.name.replace(/&/g,'&amp;')}</a>`
      })],
      ['Prezzo', items.map(p => `<span class="font-bold text-[var(--color-brand)]">${price(p.price)}</span>${p.comparePrice ? ` <span class="text-[var(--color-muted)] line-through text-sm">${price(p.comparePrice)}</span>` : ''}`)],
      ['Categoria', items.map(p => p.category ?? '—')],
      ['Tipo', items.map(p => p.type === 'digital' ? 'Digitale' : 'Fisico')],
      ['Disponibilità', items.map(p => p.isOutOfStock ? '<span class="text-red-600 font-medium">Esaurito</span>' : '<span class="text-green-600 font-medium">Disponibile</span>')],
      ['Peso', items.map(p => p.weightG > 0 ? `${p.weightG}g` : '—')],
    ]

    const colWidth = `${Math.floor(100 / (items.length + 1))}%`

    tableEl.innerHTML = `<table class="w-full text-sm border-collapse">
      <colgroup>
        <col style="width:140px" />
        ${items.map(() => `<col style="width:${colWidth}" />`).join('')}
      </colgroup>
      <tbody>
        ${rows.map(([label, cells], rowIdx) => `
          <tr class="${rowIdx % 2 === 0 ? 'bg-[var(--color-surface)]' : ''}">
            <td class="py-3 px-4 font-medium text-[var(--color-muted)] align-top whitespace-nowrap">${label}</td>
            ${cells.map(c => `<td class="py-3 px-4 align-top">${c}</td>`).join('')}
          </tr>
        `).join('')}
        <tr>
          <td class="py-3 px-4"></td>
          ${items.map(p => `<td class="py-3 px-4"><a href="/negozio/${p.slug}" class="inline-block px-4 py-2 rounded-lg bg-[var(--color-brand)] text-white text-sm font-medium hover:opacity-90 transition-opacity">Vedi prodotto</a></td>`).join('')}
        </tr>
      </tbody>
    </table>`
  }

  compareItems.subscribe(items => {
    renderTray(items)
    if (!modal.classList.contains('hidden')) renderTable(items)
  })

  slots.addEventListener('click', e => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-remove]')
    if (btn) removeFromCompare(btn.dataset.remove!)
  })

  clearBtn.addEventListener('click', clearCompare)

  openBtn.addEventListener('click', () => {
    renderTable(compareItems.get())
    modal.classList.remove('hidden')
    document.body.style.overflow = 'hidden'
  })

  function closeModal() {
    modal.classList.add('hidden')
    document.body.style.overflow = ''
  }

  document.getElementById('compare-close')?.addEventListener('click', closeModal)
  document.getElementById('compare-backdrop')?.addEventListener('click', closeModal)
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal() })
</script>
