---
// src/pages/en/portfolio/index.astro
import Page from '@/layouts/Page.astro'
import PortfolioGrid from '@/components/blocks/PortfolioGrid.astro'
import { getPortfolioItems, localizePortfolioItem } from '@/lib/directus'

const rawItems = await getPortfolioItems().catch(() => [])
const items = rawItems.map(i => localizePortfolioItem(i, 'en'))
---

<Page title="Portfolio" description="Our projects" lang="en">
  <section class="py-[var(--spacing-section)]">
    <div class="container">
      <h1 class="text-4xl font-bold mb-4" data-animate="fade-up">Portfolio</h1>
    </div>
  </section>
  <PortfolioGrid items={items} />
</Page>
