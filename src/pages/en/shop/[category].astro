---
// src/pages/en/shop/[category].astro — English category page
import Base from '@/layouts/Base.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import ProductGrid from '@/components/shop/ProductGrid.astro'
import { getProducts, getProductCategories, getProductCategoryBySlug, localizeProduct, localizeProductCategory } from '@/lib/directus'

export async function getStaticPaths() {
  try {
    const categories = await getProductCategories()
    return categories
      .filter(cat => cat.slug != null)
      .map(cat => ({ params: { category: cat.slug } }))
  } catch {
    return []
  }
}

const { category } = Astro.params
const [rawCategory, rawProducts, rawCategories] = await Promise.all([
  getProductCategoryBySlug(category!).catch(() => null),
  getProducts({ categorySlug: category }).catch(() => []),
  getProductCategories().catch(() => []),
])

const cat = rawCategory ? localizeProductCategory(rawCategory, 'en') : null
const allProducts = rawProducts.map(p => localizeProduct(p, 'en'))
const categories = rawCategories.map(c => localizeProductCategory(c, 'en'))
---

<Base
  title={cat?.seo_title ?? cat?.name ?? 'Category'}
  description={cat?.seo_description ?? cat?.description ?? undefined}
  lang="en"
>
  <Header lang="en" />
  <main class="container py-12">
    <nav class="text-sm text-[var(--color-muted)] mb-6">
      <a href="/en">Home</a> / <a href="/en/shop">Shop</a> / <span>{cat?.name}</span>
    </nav>
    <h1 class="text-4xl font-bold mb-2" data-animate="fade-up">{cat?.name}</h1>
    {cat?.description && (
      <p class="text-[var(--color-muted)] mb-8">{cat.description}</p>
    )}
    <ProductGrid products={allProducts} categories={categories} activeCategorySlug={category} lang="en" baseUrl="/en/shop" />
  </main>
  <Footer />
</Base>
