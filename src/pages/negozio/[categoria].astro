---
// src/pages/negozio/[categoria].astro — SSG
import Base from '@/layouts/Base.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import ProductGrid from '@/components/shop/ProductGrid.astro'
import { getProducts, getProductCategories, getProductCategoryBySlug } from '@/lib/directus'

export async function getStaticPaths() {
  try {
    const categories = await getProductCategories()
    return categories.map(cat => ({ params: { categoria: cat.slug } }))
  } catch {
    return []
  }
}

const { categoria } = Astro.params
const [category, allProducts, categories] = await Promise.all([
  getProductCategoryBySlug(categoria!).catch(() => null),
  getProducts({ categorySlug: categoria }).catch(() => []),
  getProductCategories().catch(() => []),
])
---

<Base
  title={category?.seo_title ?? category?.name ?? 'Categoria'}
  description={category?.seo_description ?? category?.description ?? undefined}
>
  <Header />
  <main class="container py-12">
    <nav class="text-sm text-[var(--color-muted)] mb-6">
      <a href="/">Home</a> / <a href="/negozio">Negozio</a> / <span>{category?.name}</span>
    </nav>
    <h1 class="text-4xl font-bold mb-2" data-animate="fade-up">{category?.name}</h1>
    {category?.description && (
      <p class="text-[var(--color-muted)] mb-8">{category.description}</p>
    )}
    <ProductGrid products={allProducts} categories={categories} activeCategorySlug={categoria} />
  </main>
  <Footer />
</Base>
