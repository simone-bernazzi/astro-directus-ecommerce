---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { ShippingZone } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/shipping')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const countries = formData.getAll('countries').map(String)
  const payload = {
    name: formData.get('name'),
    countries,
    base_rate: parseFloat(String(formData.get('base_rate') ?? '0')),
    rate_per_kg: parseFloat(String(formData.get('rate_per_kg') ?? '0')),
    free_shipping_threshold: formData.get('free_shipping_threshold') ? parseFloat(String(formData.get('free_shipping_threshold'))) : null,
    max_weight_g: formData.get('max_weight_g') ? parseInt(String(formData.get('max_weight_g'))) : null,
    is_active: formData.get('is_active') === 'true',
  }
  if (isNew) {
    const result = await dFetch('/items/shipping_zones', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/shipping/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const result = await dFetch(`/items/shipping_zones/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/shipping/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio.'
    }
  }
}

let zone: ShippingZone | null = null
if (!isNew) {
  const zoneRes = await dFetch(`/items/shipping_zones/${id}?fields[]=*`)
  if (!zoneRes?.data) return Astro.redirect('/admin/shipping')
  zone = zoneRes.data as ShippingZone
}

const saved = Astro.url.searchParams.get('saved') === '1'

const COUNTRIES = [
  { code: 'IT', name: 'Italia' },
  { code: 'DE', name: 'Germania' },
  { code: 'FR', name: 'Francia' },
  { code: 'ES', name: 'Spagna' },
  { code: 'PT', name: 'Portogallo' },
  { code: 'AT', name: 'Austria' },
  { code: 'CH', name: 'Svizzera' },
  { code: 'BE', name: 'Belgio' },
  { code: 'NL', name: 'Paesi Bassi' },
  { code: 'LU', name: 'Lussemburgo' },
  { code: 'PL', name: 'Polonia' },
  { code: 'CZ', name: 'Repubblica Ceca' },
  { code: 'HU', name: 'Ungheria' },
  { code: 'SK', name: 'Slovacchia' },
  { code: 'SI', name: 'Slovenia' },
  { code: 'HR', name: 'Croazia' },
  { code: 'GR', name: 'Grecia' },
  { code: 'RO', name: 'Romania' },
  { code: 'BG', name: 'Bulgaria' },
  { code: 'SE', name: 'Svezia' },
  { code: 'DK', name: 'Danimarca' },
  { code: 'FI', name: 'Finlandia' },
  { code: 'NO', name: 'Norvegia' },
  { code: 'GB', name: 'Regno Unito' },
  { code: 'IE', name: 'Irlanda' },
  { code: 'US', name: 'Stati Uniti' },
  { code: 'CA', name: 'Canada' },
  { code: 'AU', name: 'Australia' },
  { code: 'JP', name: 'Giappone' },
]
---

<AdminLayout title={isNew ? 'Nuova zona spedizione' : (zone?.name ?? '')} active="shipping">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/shipping" class="breadcrumb-back">← Spedizioni</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{isNew ? 'Nuova zona spedizione' : zone?.name}</h1>
      {!isNew && (
        <span class:list={['badge', zone?.is_active ? 'badge-success' : 'badge-neutral']}>
          {zone?.is_active ? 'Attiva' : 'Inattiva'}
        </span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <form method="POST">
    <div class="stack stack-4">

      <SectionCard title="Informazioni zona">
        <div class="form-grid">

          <div class="field field-full">
            <label class="field-label" for="zone_name">Nome zona <span class="required">*</span></label>
            <input id="zone_name" class="field-input" name="name" required value={zone?.name ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="zone_active">Stato</label>
            <select id="zone_active" class="field-select" name="is_active">
              <option value="true" selected={zone?.is_active ?? true}>Attiva</option>
              <option value="false" selected={zone ? !zone.is_active : false}>Inattiva</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="base_rate">Tariffa base (€) <span class="required">*</span></label>
            <input id="base_rate" class="field-input" name="base_rate" type="number" step="0.01" min="0" required
              value={zone?.base_rate ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="rate_per_kg">Tariffa per kg (€)</label>
            <input id="rate_per_kg" class="field-input" name="rate_per_kg" type="number" step="0.01" min="0"
              value={zone?.rate_per_kg ?? 0} />
          </div>

          <div class="field">
            <label class="field-label" for="free_threshold">Spedizione gratuita da (€)</label>
            <input id="free_threshold" class="field-input" name="free_shipping_threshold" type="number" step="0.01" min="0"
              value={zone?.free_shipping_threshold ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="max_weight">Peso massimo (g)</label>
            <input id="max_weight" class="field-input" name="max_weight_g" type="number" min="0"
              value={zone?.max_weight_g ?? ''} />
          </div>

        </div>
      </SectionCard>

      <SectionCard title="Paesi inclusi">
        <p class="field-hint" style="margin-bottom:8px">Tieni premuto Ctrl (o Cmd su Mac) per selezionare più paesi.</p>
        <select name="countries" multiple size={10} class="countries-select">
          {COUNTRIES.map(c => (
            <option value={c.code} selected={(zone?.countries ?? []).includes(c.code)}>
              {c.name} ({c.code})
            </option>
          ))}
        </select>
        {zone?.countries?.length ? (
          <p class="field-hint" style="margin-top:6px">Selezionati: {zone.countries.join(', ')}</p>
        ) : null}
      </SectionCard>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {isNew ? 'Crea zona' : 'Salva modifiche'}
        </button>
      </div>

    </div>
  </form>

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .form-actions { display: flex; justify-content: flex-end; }
  .required { color: var(--c-danger); }

  .countries-select {
    width: 100%;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 4px;
    font-size: 14px;
    color: var(--c-ink);
    background: var(--c-surface);
    font-family: inherit;
  }

  .countries-select option {
    padding: 6px 8px;
  }

  .countries-select option:checked {
    background: color-mix(in oklch, var(--admin-accent) 15%, var(--c-surface));
    color: var(--admin-accent);
  }
</style>
