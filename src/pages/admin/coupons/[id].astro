---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Coupon } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/coupons')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const payload: Record<string, unknown> = {
    code: formData.get('code'),
    type: formData.get('type'),
    value: parseFloat(String(formData.get('value') ?? '0')),
    is_active: formData.get('is_active') === 'true',
    description: formData.get('description') || null,
    min_order_amount: formData.get('min_order_amount') ? parseFloat(String(formData.get('min_order_amount'))) : null,
    max_uses: formData.get('max_uses') ? parseInt(String(formData.get('max_uses'))) : null,
    expires_at: formData.get('expires_at') || null,
  }
  if (isNew) {
    const result = await dFetch('/items/coupons', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/coupons/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const result = await dFetch(`/items/coupons/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/coupons/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio.'
    }
  }
}

let coupon: Coupon | null = null
if (!isNew) {
  const couponRes = await dFetch(`/items/coupons/${id}?fields[]=*`)
  if (!couponRes?.data) return Astro.redirect('/admin/coupons')
  coupon = couponRes.data as Coupon
}

const saved = Astro.url.searchParams.get('saved') === '1'

function toDatetimeLocal(iso: string | null | undefined): string {
  if (!iso) return ''
  return new Date(iso).toISOString().slice(0, 16)
}
---

<AdminLayout title={isNew ? 'Nuovo coupon' : `Coupon: ${coupon?.code ?? ''}`} active="coupons">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/coupons" class="breadcrumb-back">← Coupon</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px;font-family:monospace">{isNew ? 'Nuovo coupon' : coupon?.code}</h1>
      {!isNew && (
        <span class:list={['badge', coupon?.is_active ? 'badge-success' : 'badge-neutral']}>
          {coupon?.is_active ? 'Attivo' : 'Inattivo'}
        </span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <form method="POST">
    <div class="stack stack-4">

      <SectionCard title="Dettagli coupon">
        <div class="form-grid">

          <div class="field">
            <label class="field-label" for="coupon_code">Codice <span class="required">*</span></label>
            <input id="coupon_code" class="field-input" name="code" required value={coupon?.code ?? ''}
              style="font-family:monospace;text-transform:uppercase" />
          </div>

          <div class="field">
            <label class="field-label" for="coupon_active">Stato</label>
            <select id="coupon_active" class="field-select" name="is_active">
              <option value="true" selected={coupon?.is_active ?? true}>Attivo</option>
              <option value="false" selected={coupon ? !coupon.is_active : false}>Inattivo</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="coupon_type">Tipo sconto <span class="required">*</span></label>
            <select id="coupon_type" class="field-select" name="type">
              <option value="percent" selected={!coupon || coupon.type === 'percent'}>Percentuale (%)</option>
              <option value="fixed" selected={coupon?.type === 'fixed'}>Fisso (€)</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="coupon_value">Valore <span class="required">*</span></label>
            <input id="coupon_value" class="field-input" name="value" type="number" step="0.01" min="0" required
              value={coupon?.value ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="min_order">Ordine minimo (€)</label>
            <input id="min_order" class="field-input" name="min_order_amount" type="number" step="0.01" min="0"
              value={coupon?.min_order_amount ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="max_uses">Max utilizzi</label>
            <input id="max_uses" class="field-input" name="max_uses" type="number" min="0"
              value={coupon?.max_uses ?? ''} />
          </div>

          <div class="field field-full">
            <label class="field-label" for="expires_at">Scadenza</label>
            <input id="expires_at" class="field-input" name="expires_at" type="datetime-local"
              value={toDatetimeLocal(coupon?.expires_at)} style="width:auto" />
          </div>

          <div class="field field-full">
            <label class="field-label" for="coupon_desc">Descrizione interna</label>
            <textarea id="coupon_desc" class="field-textarea" name="description" rows={2}>{coupon?.description ?? ''}</textarea>
          </div>

        </div>
      </SectionCard>

      {!isNew && coupon && (
        <SectionCard title="Utilizzi">
          <p style="font-size:14px;color:var(--c-ink)">
            Utilizzato <strong>{coupon.used_count ?? 0}</strong>
            {coupon.max_uses
              ? ` volt${(coupon.used_count ?? 0) === 1 ? 'a' : 'e'} su ${coupon.max_uses} disponibili.`
              : ' volte (nessun limite).'}
          </p>
        </SectionCard>
      )}

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {isNew ? 'Crea coupon' : 'Salva modifiche'}
        </button>
      </div>

    </div>
  </form>

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .form-actions { display: flex; justify-content: flex-end; }
  .required { color: var(--c-danger); }
</style>
