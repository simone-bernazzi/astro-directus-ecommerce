---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Page } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/pages')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const payload = {
    title: formData.get('title'),
    slug: formData.get('slug'),
    status: formData.get('status'),
    seo_title: formData.get('seo_title') || null,
    seo_description: formData.get('seo_description') || null,
  }
  if (isNew) {
    const result = await dFetch('/items/pages', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/pages/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const result = await dFetch(`/items/pages/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/pages/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio.'
    }
  }
}

let page: Page | null = null
let blocks: Array<{ id: string; block_type: string; block_id: string; sort: number }> = []

if (!isNew) {
  const [pageRes, blocksRes] = await Promise.all([
    dFetch(`/items/pages/${id}?fields[]=id,title,slug,status,seo_title,seo_description`),
    dFetch(`/items/pages_blocks?filter[page_id][_eq]=${id}&fields[]=id,block_type,block_id,sort&sort[]=sort`),
  ])
  if (!pageRes?.data) return Astro.redirect('/admin/pages')
  page = pageRes.data as Page
  blocks = (blocksRes?.data ?? []) as Array<{ id: string; block_type: string; block_id: string; sort: number }>
}

const saved = Astro.url.searchParams.get('saved') === '1'
---

<AdminLayout title={isNew ? 'Nuova pagina' : (page?.title ?? '')} active="pages">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/pages" class="breadcrumb-back">← Pagine</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{isNew ? 'Nuova pagina' : page?.title}</h1>
      {!isNew && (
        <span class:list={['badge', page?.status === 'published' ? 'badge-success' : 'badge-neutral']}>
          {page?.status === 'published' ? 'Pubblicata' : 'Bozza'}
        </span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <div class:list={[isNew ? 'single-col' : 'page-layout']}>

    <form method="POST">
      <div class="stack stack-4">

        <SectionCard title="Info pagina">
          <div class="stack stack-4">

            <div class="field">
              <label class="field-label" for="page_title">Titolo <span class="required">*</span></label>
              <input id="page_title" class="field-input" name="title" required value={page?.title ?? ''} />
            </div>

            <div class="field">
              <label class="field-label" for="page_slug">Slug <span class="required">*</span></label>
              <input id="page_slug" class="field-input" name="slug" required value={page?.slug ?? ''}
                style="font-family:monospace" />
            </div>

            <div class="field">
              <label class="field-label" for="page_status">Stato</label>
              <select id="page_status" class="field-select" name="status">
                <option value="draft" selected={!page || page.status === 'draft'}>Bozza</option>
                <option value="published" selected={page?.status === 'published'}>Pubblicata</option>
              </select>
            </div>

            <div class="field">
              <label class="field-label" for="page_seo_title">SEO Title</label>
              <input id="page_seo_title" class="field-input" name="seo_title" value={page?.seo_title ?? ''} />
            </div>

            <div class="field">
              <label class="field-label" for="page_seo_desc">SEO Description</label>
              <textarea id="page_seo_desc" class="field-textarea" name="seo_description" rows={3}>{page?.seo_description ?? ''}</textarea>
            </div>

          </div>
        </SectionCard>

        <button type="submit" class="btn btn-primary" style="width:100%">
          {isNew ? 'Crea pagina' : 'Salva metadata'}
        </button>

      </div>
    </form>

    {!isNew && (
      <div>
        <SectionCard title={`Sezioni (${blocks.length})`}>
          <div id="blocks-list" class="blocks-list">
            {blocks.length === 0
              ? <p class="empty-msg">Nessuna sezione. Clicca "Aggiungi sezione" per iniziare.</p>
              : blocks.map(b => (
                <div
                  class="block-row"
                  data-junction-id={b.id}
                  data-block-type={b.block_type}
                  data-block-id={b.block_id}
                >
                  <span class="block-drag" aria-hidden="true">⠿</span>
                  <div class="block-info">
                    <span class="block-type">{b.block_type.replace('block_', '').replace(/_/g, ' ')}</span>
                    <span class="block-id">ID {b.block_id}</span>
                  </div>
                  <button
                    type="button"
                    class="btn btn-secondary btn-sm edit-block-btn"
                    data-block-type={b.block_type}
                    data-block-id={b.block_id}
                  >
                    ✏ Modifica
                  </button>
                  <button
                    type="button"
                    class="btn btn-ghost btn-sm btn-icon delete-block-btn"
                    data-junction-id={b.id}
                    aria-label="Rimuovi sezione"
                  >
                    ✕
                  </button>
                </div>
              ))
            }
          </div>
          <div style="margin-top:12px">
            <button id="add-block-btn" type="button" class="btn-add-block">
              + Aggiungi sezione
            </button>
          </div>
        </SectionCard>
      </div>
    )}

  </div>

</AdminLayout>

<!-- Edit block dialog -->
<dialog id="block-edit-dialog" class="admin-dialog">
  <div class="dialog-head">
    <span id="dialog-title" class="dialog-title"></span>
    <button id="dialog-close" type="button" class="dialog-close" aria-label="Chiudi">×</button>
  </div>
  <div id="dialog-body" class="dialog-body">
    <p style="color:var(--c-ink-muted);font-size:14px">Caricamento campi…</p>
  </div>
  <div class="dialog-foot">
    <button id="dialog-cancel" type="button" class="btn btn-secondary btn-sm">Annulla</button>
    <button id="dialog-save" type="button" class="btn btn-primary btn-sm">Salva</button>
  </div>
</dialog>

<!-- Add block dialog -->
<dialog id="add-block-dialog" class="admin-dialog" style="max-width:480px">
  <div class="dialog-head">
    <span class="dialog-title">Aggiungi sezione</span>
    <button id="add-dialog-close" type="button" class="dialog-close" aria-label="Chiudi">×</button>
  </div>
  <div id="add-dialog-body" class="dialog-body">
    <p style="color:var(--c-ink-muted);font-size:14px">Caricamento tipi disponibili…</p>
  </div>
  <div class="dialog-foot">
    <button id="add-dialog-cancel" type="button" class="btn btn-secondary btn-sm">Annulla</button>
  </div>
</dialog>

<script define:vars={{ pageId: id, directusUrl, token }}>
  const editDialog = document.getElementById('block-edit-dialog')
  const dialogTitle = document.getElementById('dialog-title')
  const dialogBody = document.getElementById('dialog-body')
  const dialogSave = document.getElementById('dialog-save')
  const dialogClose = document.getElementById('dialog-close')
  const dialogCancel = document.getElementById('dialog-cancel')

  let currentBlockType = ''
  let currentBlockId = ''

  const SKIP_FIELDS = ['id', 'date_created', 'date_updated', 'user_created', 'user_updated']

  function escHtml(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
  }

  function buildInput(field, value) {
    const label = `<label style="display:block;font-size:13px;font-weight:500;color:var(--c-ink);margin-bottom:4px">${escHtml(field.field)}${field.schema?.is_nullable === false ? ' <span style="color:var(--c-danger)">*</span>' : ''}</label>`
    const inputStyle = 'width:100%;border:1px solid var(--c-border);border-radius:var(--r-md);padding:8px 12px;font-size:14px;color:var(--c-ink);box-sizing:border-box;background:var(--c-surface);font-family:inherit'
    const val = value ?? ''

    if (field.meta?.interface === 'select-dropdown' && field.meta?.options?.choices) {
      const options = field.meta.options.choices.map(c =>
        `<option value="${escHtml(c.value)}" ${val === c.value ? 'selected' : ''}>${escHtml(c.text)}</option>`
      ).join('')
      return `<div style="margin-bottom:14px">${label}<select name="${escHtml(field.field)}" style="${inputStyle}">${options}</select></div>`
    }

    if (field.type === 'boolean') {
      return `<div style="margin-bottom:14px;display:flex;align-items:center;gap:8px">
        <input type="checkbox" name="${escHtml(field.field)}" id="f_${escHtml(field.field)}" ${val ? 'checked' : ''} style="width:16px;height:16px;accent-color:var(--admin-accent)">
        <label for="f_${escHtml(field.field)}" style="font-size:13px;font-weight:500;color:var(--c-ink)">${escHtml(field.field)}</label>
      </div>`
    }

    if (field.type === 'text' || field.meta?.interface === 'input-multiline') {
      return `<div style="margin-bottom:14px">${label}<textarea name="${escHtml(field.field)}" rows="4" style="${inputStyle};resize:vertical">${escHtml(String(val))}</textarea></div>`
    }

    if (field.type === 'integer' || field.type === 'float' || field.type === 'decimal') {
      return `<div style="margin-bottom:14px">${label}<input type="number" name="${escHtml(field.field)}" value="${escHtml(String(val))}" style="${inputStyle}"></div>`
    }

    if (field.type === 'timestamp' || field.type === 'dateTime') {
      const dtVal = val ? new Date(val).toISOString().slice(0, 16) : ''
      return `<div style="margin-bottom:14px">${label}<input type="datetime-local" name="${escHtml(field.field)}" value="${escHtml(dtVal)}" style="${inputStyle}"></div>`
    }

    return `<div style="margin-bottom:14px">${label}<input type="text" name="${escHtml(field.field)}" value="${escHtml(String(val))}" style="${inputStyle}"></div>`
  }

  async function openEditDialog(blockType, blockId) {
    currentBlockType = blockType
    currentBlockId = blockId
    dialogTitle.textContent = blockType.replace('block_', '').replace(/_/g, ' ')
    dialogBody.innerHTML = '<p style="color:var(--c-ink-muted);font-size:14px">Caricamento campi…</p>'
    editDialog.showModal()

    try {
      const [fieldsRes, dataRes] = await Promise.all([
        fetch(`${directusUrl}/fields/${blockType}`, { headers: { Authorization: `Bearer ${token}` } }),
        fetch(`${directusUrl}/items/${blockType}/${blockId}?fields[]=*`, { headers: { Authorization: `Bearer ${token}` } }),
      ])
      const { data: fields } = await fieldsRes.json()
      const { data: blockData } = await dataRes.json()

      const visibleFields = fields.filter(f => !SKIP_FIELDS.includes(f.field) && f.meta?.hidden !== true)

      if (!visibleFields.length) {
        dialogBody.innerHTML = '<p style="color:var(--c-ink-muted);font-size:14px">Nessun campo modificabile.</p>'
        return
      }

      dialogBody.innerHTML = visibleFields.map(f => buildInput(f, blockData[f.field])).join('')
    } catch (e) {
      dialogBody.innerHTML = '<p style="color:var(--c-danger);font-size:14px">Errore caricamento campi.</p>'
    }
  }

  async function saveBlock() {
    const inputs = dialogBody.querySelectorAll('input, textarea, select')
    const payload = {}
    inputs.forEach(input => {
      if (input.type === 'checkbox') {
        payload[input.name] = input.checked
      } else {
        payload[input.name] = input.value || null
      }
    })

    dialogSave.disabled = true
    dialogSave.textContent = 'Salvataggio…'

    try {
      const res = await fetch(`${directusUrl}/items/${currentBlockType}/${currentBlockId}`, {
        method: 'PATCH',
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      if (res.ok) {
        editDialog.close()
      } else {
        alert('Errore durante il salvataggio.')
      }
    } catch {
      alert('Errore di rete.')
    } finally {
      dialogSave.disabled = false
      dialogSave.textContent = 'Salva'
    }
  }

  async function deleteBlock(junctionId) {
    if (!confirm('Rimuovere questa sezione dalla pagina?')) return
    try {
      await fetch(`${directusUrl}/items/pages_blocks/${junctionId}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      })
      window.location.reload()
    } catch {
      alert('Errore durante l\'eliminazione.')
    }
  }

  document.querySelectorAll('.edit-block-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openEditDialog(btn.dataset.blockType, btn.dataset.blockId)
    })
  })

  document.querySelectorAll('.delete-block-btn').forEach(btn => {
    btn.addEventListener('click', () => deleteBlock(btn.dataset.junctionId))
  })

  dialogSave?.addEventListener('click', saveBlock)
  dialogClose?.addEventListener('click', () => editDialog.close())
  dialogCancel?.addEventListener('click', () => editDialog.close())

  const addBlockBtn = document.getElementById('add-block-btn')
  const addDialog = document.getElementById('add-block-dialog')
  const addDialogBody = document.getElementById('add-dialog-body')
  const addDialogClose = document.getElementById('add-dialog-close')
  const addDialogCancel = document.getElementById('add-dialog-cancel')

  addBlockBtn?.addEventListener('click', async () => {
    addDialogBody.innerHTML = '<p style="color:var(--c-ink-muted);font-size:14px">Caricamento…</p>'
    addDialog.showModal()

    try {
      const res = await fetch(`${directusUrl}/collections`, { headers: { Authorization: `Bearer ${token}` } })
      const { data: collections } = await res.json()
      const blockCollections = collections.filter(c => c.collection.startsWith('block_'))

      if (!blockCollections.length) {
        addDialogBody.innerHTML = '<p style="color:var(--c-ink-muted);font-size:14px">Nessun tipo di blocco disponibile. Crea prima una collection con prefisso <code>block_</code> in Directus.</p>'
        return
      }

      addDialogBody.innerHTML = blockCollections.map(c => `
        <button type="button" class="add-block-type-btn"
          data-collection="${escHtml(c.collection)}"
          style="display:block;width:100%;text-align:left;border:1px solid var(--c-border);background:var(--c-surface);padding:10px 14px;border-radius:var(--r-md);font-size:14px;color:var(--c-ink);cursor:pointer;margin-bottom:8px;font-family:inherit;transition:background 150ms">
          ${escHtml(c.collection.replace('block_', '').replace(/_/g, ' '))}
        </button>
      `).join('')

      document.querySelectorAll('.add-block-type-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const collection = btn.dataset.collection
          try {
            const blockRes = await fetch(`${directusUrl}/items/${collection}`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({}),
            })
            const { data: newBlock } = await blockRes.json()

            const lastSort = [...document.querySelectorAll('.block-row')].length

            const junctionRes = await fetch(`${directusUrl}/items/pages_blocks`, {
              method: 'POST',
              headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({ page_id: pageId, block_type: collection, block_id: newBlock.id, sort: lastSort + 1 }),
            })

            if (!junctionRes.ok) {
              await fetch(`${directusUrl}/items/${collection}/${newBlock.id}`, {
                method: 'DELETE',
                headers: { Authorization: `Bearer ${token}` },
              }).catch(() => {})
              alert('Errore durante la creazione del blocco.')
              return
            }

            addDialog.close()
            window.location.reload()
          } catch {
            alert('Errore durante la creazione del blocco.')
          }
        })
      })
    } catch {
      addDialogBody.innerHTML = '<p style="color:var(--c-danger);font-size:14px">Errore caricamento collection.</p>'
    }
  })

  addDialogClose?.addEventListener('click', () => addDialog.close())
  addDialogCancel?.addEventListener('click', () => addDialog.close())

  editDialog?.addEventListener('click', e => { if (e.target === editDialog) editDialog.close() })
  addDialog?.addEventListener('click', e => { if (e.target === addDialog) addDialog.close() })
</script>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .required { color: var(--c-danger); }
  .empty-msg { color: var(--c-ink-muted); font-size: 14px; margin: 0; }

  .single-col { display: flex; flex-direction: column; gap: 16px; }

  .page-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 800px) {
    .page-layout { grid-template-columns: 1fr; }
  }

  /* Blocks */
  .blocks-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .block-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    transition: border-color 150ms;
  }

  .block-row:hover { border-color: var(--c-border-2); }

  .block-drag {
    color: var(--c-border-2);
    cursor: grab;
    font-size: 16px;
    line-height: 1;
  }

  .block-info { flex: 1; min-width: 0; }

  .block-type {
    font-size: 13px;
    font-weight: 500;
    color: var(--c-ink);
    text-transform: capitalize;
  }

  .block-id {
    font-size: 12px;
    color: var(--c-ink-muted);
    margin-left: 8px;
  }

  .btn-add-block {
    width: 100%;
    border: 1px dashed var(--c-border-2);
    background: var(--c-bg);
    padding: 10px;
    border-radius: var(--r-md);
    font-size: 13px;
    color: var(--c-ink-muted);
    cursor: pointer;
    transition: border-color 150ms, color 150ms;
    font-family: inherit;
  }

  .btn-add-block:hover {
    border-color: var(--admin-accent);
    color: var(--admin-accent);
  }

  /* Dialogs */
  .admin-dialog {
    border: none;
    border-radius: var(--r-xl);
    box-shadow: 0 20px 60px oklch(0 0 0 / 0.15);
    padding: 0;
    max-width: 560px;
    width: 90vw;
    max-height: 80vh;
    overflow: hidden;
    background: var(--c-surface);
  }

  .admin-dialog::backdrop {
    background: oklch(0 0 0 / 0.4);
  }

  .dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface-2);
  }

  .dialog-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--c-ink);
    text-transform: capitalize;
  }

  .dialog-close {
    border: none;
    background: none;
    font-size: 18px;
    cursor: pointer;
    color: var(--c-ink-muted);
    line-height: 1;
    padding: 4px;
    border-radius: var(--r-sm);
    transition: color 150ms;
  }

  .dialog-close:hover { color: var(--c-ink); }

  .dialog-body {
    padding: 20px;
    overflow-y: auto;
    max-height: calc(80vh - 120px);
  }

  .dialog-foot {
    padding: 14px 20px;
    border-top: 1px solid var(--c-border);
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
</style>
