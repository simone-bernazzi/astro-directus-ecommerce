---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import DataTable from '@/components/admin/DataTable.astro'
import type { Column } from '@/components/admin/DataTable.astro'
import type { Form, FormSubmission } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/forms')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST' && isNew) {
  const formData = await Astro.request.formData()
  const payload = {
    name: formData.get('name'),
    slug: formData.get('slug'),
    notification_email: formData.get('notification_email') || null,
    is_active: formData.get('is_active') === 'true',
    fields: [],
  }
  const result = await dFetch('/items/forms', { method: 'POST', body: JSON.stringify(payload) })
  if (result?.data?.id) {
    return Astro.redirect(`/admin/forms/${result.data.id}?saved=1`)
  } else {
    saveError = 'Errore durante la creazione.'
  }
}

let form: Form | null = null
let submissions: Partial<FormSubmission>[] = []
let subTotal = 0
let subPage = 1

if (!isNew) {
  const SUB_PAGE_SIZE = 25
  subPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'))
  const subOffset = (subPage - 1) * SUB_PAGE_SIZE

  const [formRes, subsRes, subCountRes] = await Promise.all([
    dFetch(`/items/forms/${id}?fields[]=*`),
    dFetch(`/items/form_submissions?filter[form_id][_eq]=${id}&fields[]=id,data,date_created,is_read&sort[]=-date_created&limit=${SUB_PAGE_SIZE}&offset=${subOffset}`),
    dFetch(`/items/form_submissions?filter[form_id][_eq]=${id}&aggregate[count]=id`),
  ])

  if (!formRes?.data) return Astro.redirect('/admin/forms')

  form = formRes.data as Form
  submissions = (subsRes?.data ?? []) as Partial<FormSubmission>[]
  subTotal = parseInt(subCountRes?.data?.[0]?.count?.id ?? '0')
}

const SUB_PAGE_SIZE = 25
const saved = Astro.url.searchParams.get('saved') === '1'

function escHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
}

function extractPreview(data: unknown): string {
  if (!data || typeof data !== 'object') return '—'
  const val = Object.values(data as Record<string, unknown>)[0]
  const str = String(val ?? '')
  const truncated = str.length > 60 ? str.slice(0, 60) + '…' : str || '—'
  return escHtml(truncated)
}

const subColumns: Column[] = [
  {
    key: 'data',
    label: 'Anteprima',
    format: (v) => `<span style="color:var(--c-ink);font-size:13px">${extractPreview(v)}</span>`,
  },
  {
    key: 'date_created',
    label: 'Data',
    format: (v) => v ? new Date(String(v)).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '—',
  },
  {
    key: 'is_read',
    label: 'Stato',
    format: (v) => v
      ? `<span class="badge badge-neutral">Letto</span>`
      : `<span class="badge badge-warning">Nuovo</span>`,
  },
]
---

<AdminLayout title={isNew ? 'Nuovo form' : (form?.name ?? '')} active="forms">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/forms" class="breadcrumb-back">← Form</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{isNew ? 'Nuovo form' : form?.name}</h1>
      {!isNew && (
        <span class:list={['badge', form?.is_active ? 'badge-success' : 'badge-neutral']}>
          {form?.is_active ? 'Attivo' : 'Inattivo'}
        </span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <div class="stack stack-4">

    {isNew && (
      <form method="POST">
        <SectionCard title="Nuovo form">
          <div class="stack stack-4">

            <div class="field">
              <label class="field-label" for="form_name">Nome <span class="required">*</span></label>
              <input id="form_name" class="field-input" name="name" required />
            </div>

            <div class="field">
              <label class="field-label" for="form_slug">Slug <span class="required">*</span></label>
              <input id="form_slug" class="field-input" name="slug" required style="font-family:monospace" />
            </div>

            <div class="field">
              <label class="field-label" for="form_email">Email di notifica</label>
              <input id="form_email" class="field-input" name="notification_email" type="email" />
            </div>

            <div class="field">
              <label class="field-label" for="form_active">Stato</label>
              <select id="form_active" class="field-select" name="is_active">
                <option value="true">Attivo</option>
                <option value="false">Inattivo</option>
              </select>
            </div>

          </div>
        </SectionCard>
        <div class="form-actions" style="margin-top:16px">
          <button type="submit" class="btn btn-primary">Crea form</button>
        </div>
      </form>
    )}

    {!isNew && form && (
      <>
        <SectionCard title="Configurazione">
          <div class="config-grid">
            <div class="config-row">
              <span class="config-label">Slug</span>
              <code style="font-size:12px;color:var(--c-ink)">{form.slug}</code>
            </div>
            <div class="config-row">
              <span class="config-label">Campi</span>
              <span>{form.fields?.length ?? 0}</span>
            </div>
            <div class="config-row">
              <span class="config-label">Notifica email</span>
              <span>{form.notification_email ?? '—'}</span>
            </div>
            <div class="config-row">
              <span class="config-label">Redirect</span>
              <span>{form.redirect_enabled ? (form.redirect_url ?? '—') : 'No'}</span>
            </div>
            <div class="config-row">
              <span class="config-label">reCAPTCHA</span>
              <span>{form.recaptcha_enabled ? 'Sì' : 'No'}</span>
            </div>
            <div class="config-row">
              <span class="config-label">Honeypot</span>
              <span>{form.honeypot_enabled ? 'Sì' : 'No'}</span>
            </div>
          </div>
        </SectionCard>

        {form.fields && form.fields.length > 0 && (
          <SectionCard title="Campi form">
            <div class="fields-list">
              {form.fields.map((f) => (
                <div class="field-row">
                  <span class="field-row-name">{f.name}</span>
                  <span class="field-row-label">{f.label}</span>
                  <span class="badge badge-neutral" style="font-size:11px">{f.type}</span>
                  {f.required && <span style="color:var(--c-danger);font-size:12px;font-weight:600">*</span>}
                </div>
              ))}
            </div>
          </SectionCard>
        )}

        <SectionCard title={`Submissions (${subTotal})`}>
          <DataTable
            columns={subColumns}
            rows={submissions as unknown as Record<string, unknown>[]}
            idField="id"
            detailBase="/admin/contact-submissions/"
            page={subPage}
            total={subTotal}
            pageSize={SUB_PAGE_SIZE}
            emptyMessage="Nessuna submission."
          />
        </SectionCard>
      </>
    )}

  </div>

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .form-actions { display: flex; justify-content: flex-end; }
  .required { color: var(--c-danger); }

  .config-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    font-size: 14px;
  }

  .config-row {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .config-label {
    color: var(--c-ink-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .fields-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--c-border);
    font-size: 13px;
  }

  .field-row:last-child { border-bottom: none; }

  .field-row-name {
    font-family: monospace;
    color: var(--c-ink-muted);
    font-size: 12px;
    min-width: 120px;
  }

  .field-row-label {
    color: var(--c-ink);
    font-weight: 500;
    flex: 1;
  }
</style>
