---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Order } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/orders')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST' && isNew) {
  const formData = await Astro.request.formData()
  const itemsCount = parseInt(String(formData.get('items_count') ?? '0'))
  const items: Array<{ product_name: string; variant_name: string | null; sku: string | null; quantity: number; unit_price: number }> = []
  for (let i = 0; i < itemsCount; i++) {
    const name = String(formData.get(`item_${i}_name`) ?? '').trim()
    const qty = parseInt(String(formData.get(`item_${i}_qty`) ?? '1'))
    const price = parseFloat(String(formData.get(`item_${i}_price`) ?? '0'))
    if (name && qty > 0) {
      items.push({
        product_name: name,
        variant_name: String(formData.get(`item_${i}_variant`) ?? '').trim() || null,
        sku: String(formData.get(`item_${i}_sku`) ?? '').trim() || null,
        quantity: qty,
        unit_price: price,
      })
    }
  }
  const subtotal = items.reduce((s, i) => s + i.unit_price * i.quantity, 0)
  const discountAmount = parseFloat(String(formData.get('discount_amount') ?? '0')) || 0
  const shippingCost = parseFloat(String(formData.get('shipping_cost') ?? '0')) || 0
  const total = Math.max(0, subtotal - discountAmount + shippingCost)

  const orderResult = await dFetch('/items/orders', {
    method: 'POST',
    body: JSON.stringify({
      customer_name: formData.get('customer_name'),
      customer_email: String(formData.get('customer_email') ?? '').trim() || null,
      contact_id: String(formData.get('contact_id') ?? '').trim() || null,
      subtotal, discount_amount: discountAmount, shipping_cost: shippingCost, total,
      status: formData.get('status') ?? 'paid',
      channel: 'offline',
      notes: String(formData.get('notes') ?? '').trim() || null,
    }),
  })
  if (orderResult?.data?.id) {
    const orderId = orderResult.data.id
    for (const item of items) {
      await dFetch('/items/order_items', { method: 'POST', body: JSON.stringify({ ...item, order_id: orderId }) })
    }
    return Astro.redirect(`/admin/orders/${orderId}?saved=1`)
  } else {
    saveError = 'Errore durante la creazione dell\'ordine.'
  }
}

type ProductOption = { id: string; name: string; base_price: number; variants: Array<{ id: string; name: string; sku: string; price_override: number | null }> }
type ContactOption = { id: string; first_name: string; last_name: string; email: string | null }

let productsForSelect: ProductOption[] = []
let contactsForSelect: ContactOption[] = []

if (isNew) {
  const [prodsRes, contsRes] = await Promise.all([
    dFetch('/items/products?fields[]=id,name,base_price,variants.id,variants.name,variants.sku,variants.price_override&filter[status][_eq]=published&sort[]=name&limit=500'),
    dFetch('/items/contacts?fields[]=id,first_name,last_name,email&sort[]=first_name&limit=500'),
  ])
  productsForSelect = (prodsRes?.data ?? []) as ProductOption[]
  contactsForSelect = (contsRes?.data ?? []) as ContactOption[]
}

let order: Order | null = null
if (!isNew) {
  const orderRes = await dFetch(`/items/orders/${id}?fields[]=*,order_items.*`)
  if (!orderRes?.data) return Astro.redirect('/admin/orders')
  order = orderRes.data as Order
}

const saved = Astro.url.searchParams.get('saved') === '1'

const ORDER_STATUS_LABELS: Record<string, string> = {
  pending: 'In attesa', paid: 'Pagato', shipped: 'Spedito',
  delivered: 'Consegnato', refunded: 'Rimborsato',
}
const ORDER_STATUS_BADGE: Record<string, string> = {
  pending: 'badge-warning', paid: 'badge-info', shipped: 'badge-info',
  delivered: 'badge-success', refunded: 'badge-neutral',
}

function fmtDate(iso: string | null | undefined) {
  if (!iso) return '—'
  return new Date(iso).toLocaleString('it-IT', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' })
}

function fmtCurrency(n: number) {
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n)
}

const productsJson = JSON.stringify(productsForSelect)
const contactsJson = JSON.stringify(contactsForSelect)
---

<AdminLayout title={isNew ? 'Nuovo ordine offline' : `Ordine #${order?.id?.slice(0, 8)}`} active="orders">

  <!-- Breadcrumb -->
  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/orders" class="breadcrumb-back">← Ordini</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">
        {isNew ? 'Nuovo ordine offline' : `#${order?.id?.slice(0, 8)}`}
      </h1>
      {!isNew && order && (
        <span class:list={['badge', ORDER_STATUS_BADGE[order.status] ?? 'badge-neutral']}>
          {ORDER_STATUS_LABELS[order.status] ?? order.status}
        </span>
      )}
      {!isNew && order && (
        <span class="order-date">{fmtDate(order.date_created)}</span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Ordine creato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <!-- CREATE MODE -->
  {isNew && (
    <form method="POST" id="order-form">
      <input type="hidden" name="items_count" id="items_count" value="0" />
      <div class="stack stack-4">

        <SectionCard title="Cliente">
          <div class="form-grid">
            <div class="field">
              <label class="field-label" for="customer_name">Nome cliente <span class="required">*</span></label>
              <input id="customer_name" class="field-input" name="customer_name" required />
            </div>
            <div class="field">
              <label class="field-label" for="customer_email">Email</label>
              <input id="customer_email" class="field-input" name="customer_email" type="email" />
            </div>
            <div class="field field-full">
              <label class="field-label" for="contact_select">Collega a contatto esistente</label>
              <select id="contact_select" class="field-select" name="contact_id">
                <option value="">— nessuno —</option>
                {contactsForSelect.map(c => (
                  <option value={c.id}>{c.first_name} {c.last_name}{c.email ? ` (${c.email})` : ''}</option>
                ))}
              </select>
            </div>
          </div>
        </SectionCard>

        <SectionCard title="Prodotti">
          <div class="catalog-toolbar">
            <div class="field" style="flex:1;min-width:200px;margin-bottom:0">
              <label class="field-label" for="catalog_select">Cerca dal catalogo</label>
              <select id="catalog_select" class="field-select">
                <option value="">— seleziona prodotto —</option>
                {productsForSelect.map(p => (
                  <option value={p.id} data-price={p.base_price} data-name={p.name}>
                    {p.name} — {fmtCurrency(p.base_price)}
                  </option>
                ))}
              </select>
            </div>
            <div class="catalog-btns">
              <button type="button" id="add_from_catalog" class="btn btn-primary btn-sm">+ Dal catalogo</button>
              <button type="button" id="add_manual" class="btn btn-secondary btn-sm">+ Riga manuale</button>
            </div>
          </div>

          <div id="items_container" style="margin-top:12px">
            <p id="empty_msg" class="empty-items">Nessun prodotto aggiunto.</p>
          </div>

          <div class="totals-box">
            <div class="total-row">
              <span class="total-label">Subtotale</span>
              <span id="display_subtotal" class="total-value">€0,00</span>
            </div>
            <div class="total-row">
              <span class="total-label">Sconto (€)</span>
              <input name="discount_amount" id="discount_amount" type="number" step="0.01" min="0" value="0"
                oninput="recalc()" class="total-input" />
            </div>
            <div class="total-row">
              <span class="total-label">Spedizione (€)</span>
              <input name="shipping_cost" id="shipping_cost" type="number" step="0.01" min="0" value="0"
                oninput="recalc()" class="total-input" />
            </div>
            <div class="total-row total-final">
              <span>Totale</span>
              <span id="display_total">€0,00</span>
            </div>
          </div>
        </SectionCard>

        <SectionCard title="Dettagli ordine">
          <div class="form-grid">
            <div class="field">
              <label class="field-label" for="order_status">Stato</label>
              <select id="order_status" class="field-select" name="status">
                <option value="paid">Pagato</option>
                <option value="pending">In attesa di pagamento</option>
                <option value="delivered">Consegnato</option>
              </select>
            </div>
            <div class="field field-full">
              <label class="field-label" for="order_notes">Note</label>
              <textarea id="order_notes" class="field-textarea" name="notes" rows={3}></textarea>
            </div>
          </div>
        </SectionCard>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Crea ordine</button>
        </div>

      </div>
    </form>
  )}

  <!-- VIEW MODE -->
  {!isNew && order && (
    <div class="stack stack-4">

      <SectionCard title="Informazioni ordine">
        <div class="info-grid">
          <div class="info-row"><span class="info-label">Cliente</span> <strong>{order.customer_name}</strong></div>
          <div class="info-row"><span class="info-label">Email</span> {order.customer_email ?? '—'}</div>
          <div class="info-row"><span class="info-label">Canale</span> {order.channel}</div>
          <div class="info-row"><span class="info-label">Stripe session</span> <code class="mono-sm">{order.stripe_session_id ?? '—'}</code></div>
          {order.notes && <div class="info-row info-full"><span class="info-label">Note</span> {order.notes}</div>}
          {order.tracking_number && (
            <div class="info-row info-full">
              <span class="info-label">Tracking</span>
              {order.tracking_url
                ? <a href={order.tracking_url} target="_blank" rel="noopener" style="color:var(--admin-accent)">{order.tracking_number}</a>
                : order.tracking_number}
            </div>
          )}
        </div>
      </SectionCard>

      <SectionCard title={`Prodotti (${order.order_items?.length ?? 0})`}>
        {!order.order_items?.length
          ? <p class="empty-msg">Nessun prodotto.</p>
          : (
            <div class="table-wrap" style="border:none;border-radius:0;margin:-16px">
              <table class="data-table" style="white-space:nowrap">
                <thead>
                  <tr>
                    <th>Prodotto</th>
                    <th>SKU</th>
                    <th style="text-align:center">Qtà</th>
                    <th style="text-align:right">Prezzo</th>
                    <th style="text-align:right">Totale</th>
                  </tr>
                </thead>
                <tbody>
                  {order.order_items.map(item => (
                    <tr>
                      <td>
                        <div style="font-weight:500">{item.product_name}</div>
                        {item.variant_name && <div style="font-size:12px;color:var(--c-ink-muted)">{item.variant_name}</div>}
                      </td>
                      <td style="font-family:monospace;font-size:12px;color:var(--c-ink-muted)">{item.sku ?? '—'}</td>
                      <td style="text-align:center">{item.quantity}</td>
                      <td style="text-align:right">{fmtCurrency(item.unit_price)}</td>
                      <td style="text-align:right;font-weight:500">{fmtCurrency(item.unit_price * item.quantity)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </SectionCard>

      <SectionCard title="Spedizione">
        {order.shipping_address
          ? (
            <div class="address-block">
              <p style="font-weight:500">{order.shipping_address.name}</p>
              <p style="color:var(--c-ink-muted)">{order.shipping_address.line1}{order.shipping_address.line2 ? `, ${order.shipping_address.line2}` : ''}</p>
              <p style="color:var(--c-ink-muted)">{order.shipping_address.postal_code} {order.shipping_address.city} ({order.shipping_address.state}), {order.shipping_address.country}</p>
            </div>
          )
          : <p class="empty-msg">Nessun indirizzo di spedizione.</p>
        }
      </SectionCard>

      <SectionCard title="Riepilogo pagamento">
        <div class="payment-summary">
          <div class="payment-row"><span class="info-label">Subtotale</span><span>{fmtCurrency(order.subtotal)}</span></div>
          {order.discount_amount > 0 && (
            <div class="payment-row" style="color:var(--c-success)"><span>Sconto</span><span>-{fmtCurrency(order.discount_amount)}</span></div>
          )}
          {(order.gift_card_amount_used ?? 0) > 0 && (
            <div class="payment-row" style="color:var(--c-success)"><span>Gift card</span><span>-{fmtCurrency(order.gift_card_amount_used ?? 0)}</span></div>
          )}
          <div class="payment-row"><span class="info-label">Spedizione</span><span>{fmtCurrency(order.shipping_cost)}</span></div>
          <div class="payment-row payment-total"><span>Totale</span><span>{fmtCurrency(order.total)}</span></div>
        </div>
      </SectionCard>

    </div>
  )}

</AdminLayout>

{isNew && (
<script define:vars={{ productsJson, contactsJson }}>
  const products = JSON.parse(productsJson)
  let rowCount = 0

  function fmtEur(n) {
    return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n)
  }

  function recalc() {
    let subtotal = 0
    document.querySelectorAll('.item-row').forEach(row => {
      const qty = parseFloat(row.querySelector('.item-qty').value) || 0
      const price = parseFloat(row.querySelector('.item-price').value) || 0
      const lineEl = row.querySelector('.item-line')
      const line = qty * price
      if (lineEl) lineEl.textContent = fmtEur(line)
      subtotal += line
    })
    document.getElementById('display_subtotal').textContent = fmtEur(subtotal)
    const discount = parseFloat(document.getElementById('discount_amount').value) || 0
    const shipping = parseFloat(document.getElementById('shipping_cost').value) || 0
    document.getElementById('display_total').textContent = fmtEur(Math.max(0, subtotal - discount + shipping))
  }

  function updateCount() {
    document.getElementById('items_count').value = rowCount
    const empty = document.getElementById('empty_msg')
    if (empty) empty.style.display = rowCount === 0 ? '' : 'none'
  }

  function escHtml(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')
  }

  function addRow(name, sku, variant, price) {
    const idx = rowCount++
    const container = document.getElementById('items_container')
    const row = document.createElement('div')
    row.className = 'item-row'
    row.innerHTML = `
      <div class="item-cell-name">
        <input class="item-name field-input" name="item_${idx}_name" value="${escHtml(name)}" required placeholder="Nome prodotto" style="margin-bottom:4px" />
        <input class="field-input" name="item_${idx}_variant" value="${escHtml(variant)}" placeholder="Variante" style="font-size:12px;color:var(--c-ink-muted)" />
      </div>
      <input class="item-sku field-input" name="item_${idx}_sku" value="${escHtml(sku)}" placeholder="SKU" style="font-family:monospace;font-size:12px" />
      <input class="item-qty field-input" name="item_${idx}_qty" type="number" min="1" value="1" oninput="recalc()" style="text-align:center" />
      <input class="item-price field-input" name="item_${idx}_price" type="number" step="0.01" min="0" value="${price.toFixed(2)}" oninput="recalc()" style="text-align:right" />
      <span class="item-line" style="font-size:13px;font-weight:600;text-align:right;color:var(--c-ink)">${fmtEur(price)}</span>
      <button type="button" onclick="removeRow(this)" class="btn btn-ghost btn-icon btn-sm" title="Rimuovi riga" style="color:var(--c-danger)">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    `
    container.appendChild(row)
    updateCount()
    recalc()
  }

  function removeRow(btn) {
    btn.closest('.item-row').remove()
    rowCount = document.querySelectorAll('.item-row').length
    updateCount()
    recalc()
  }

  document.getElementById('add_from_catalog').addEventListener('click', () => {
    const sel = document.getElementById('catalog_select')
    const opt = sel.selectedOptions[0]
    if (!opt || !opt.value) return
    const p = products.find(p => p.id === opt.value)
    if (!p) return
    addRow(p.name, p.variants?.[0]?.sku ?? '', '', p.base_price)
    sel.value = ''
  })

  document.getElementById('add_manual').addEventListener('click', () => addRow('', '', '', 0))

  document.getElementById('contact_select').addEventListener('change', (e) => {
    const opt = e.target.selectedOptions[0]
    if (!opt || !opt.value) return
    const text = opt.textContent.replace(/\s*\(.*\)$/, '').trim()
    const nameField = document.querySelector('[name="customer_name"]')
    if (nameField && !nameField.value) nameField.value = text
  })

  window.recalc = recalc
  window.removeRow = removeRow
</script>
)}

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .order-date { font-size: 13px; color: var(--c-ink-muted); margin-left: auto; }

  .form-actions { display: flex; justify-content: flex-end; }

  .empty-msg { font-size: 14px; color: var(--c-ink-muted); }

  .required { color: var(--c-danger); }

  /* Catalog toolbar */
  .catalog-toolbar {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .catalog-btns {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    padding-top: 20px; /* align with inputs */
  }

  /* Item rows */
  .empty-items {
    text-align: center;
    padding: 20px 0;
    color: var(--c-ink-muted);
    font-size: 14px;
  }

  .item-row {
    display: grid;
    grid-template-columns: 2fr 1fr 80px 90px 80px 36px;
    gap: 8px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--c-border);
  }

  .item-cell-name { display: flex; flex-direction: column; gap: 4px; }

  /* Totals */
  .totals-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 280px;
    margin-left: auto;
    margin-top: 16px;
    border-top: 1px solid var(--c-border);
    padding-top: 12px;
    font-size: 14px;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .total-label { color: var(--c-ink-muted); }
  .total-value { font-weight: 500; }

  .total-input {
    width: 90px;
    border: 1px solid var(--c-border-2);
    border-radius: var(--r-md);
    padding: 4px 8px;
    font-size: 13px;
    text-align: right;
    font-family: inherit;
    color: var(--c-ink);
    background: var(--c-surface);
  }

  .total-final {
    font-weight: 700;
    font-size: 16px;
    border-top: 1px solid var(--c-border);
    padding-top: 8px;
    margin-top: 4px;
  }

  /* Info grid (view mode) */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .info-grid { grid-template-columns: 1fr; }
  }

  .info-row { display: flex; gap: 8px; }
  .info-full { grid-column: 1 / -1; }
  .info-label { color: var(--c-ink-muted); flex-shrink: 0; }
  .mono-sm { font-family: monospace; font-size: 11px; color: var(--c-ink-muted); }

  .address-block { font-size: 14px; line-height: 1.7; }

  /* Payment summary */
  .payment-summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 280px;
    font-size: 14px;
  }

  .payment-row {
    display: flex;
    justify-content: space-between;
  }

  .payment-total {
    font-weight: 700;
    font-size: 16px;
    border-top: 1px solid var(--c-border);
    padding-top: 8px;
    margin-top: 4px;
  }
</style>
