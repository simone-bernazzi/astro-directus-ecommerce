---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { GiftCard } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/gift-cards')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  if (isNew) {
    const initialValue = parseFloat(String(formData.get('initial_value') ?? '0'))
    const payload = {
      code: String(formData.get('code') ?? '').toUpperCase(),
      initial_value: initialValue,
      remaining_value: initialValue,
      expires_at: formData.get('expires_at') || null,
      is_active: formData.get('is_active') === 'true',
    }
    const result = await dFetch('/items/gift_cards', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/gift-cards/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const payload = {
      expires_at: formData.get('expires_at') || null,
      is_active: formData.get('is_active') === 'true',
    }
    const result = await dFetch(`/items/gift_cards/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/gift-cards/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio.'
    }
  }
}

let card: GiftCard | null = null
if (!isNew) {
  const cardRes = await dFetch(`/items/gift_cards/${id}?fields[]=*`)
  if (!cardRes?.data) return Astro.redirect('/admin/gift-cards')
  card = cardRes.data as GiftCard
}

const saved = Astro.url.searchParams.get('saved') === '1'

function fmtDate(iso: string | null | undefined) {
  if (!iso) return '—'
  return new Date(iso).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: '2-digit' })
}

function toDatetimeLocal(iso: string | null | undefined): string {
  if (!iso) return ''
  return new Date(iso).toISOString().slice(0, 16)
}

const isExpired = card?.expires_at ? new Date(card.expires_at) < new Date() : false
const percentUsed = (card?.initial_value ?? 0) > 0
  ? Math.round((1 - (card?.remaining_value ?? 0) / (card?.initial_value ?? 1)) * 100)
  : 0

function cardBadgeClass() {
  if (isExpired) return 'badge-danger'
  if (card?.is_active) return 'badge-success'
  return 'badge-neutral'
}

function cardBadgeLabel() {
  if (isExpired) return 'Scaduta'
  if (card?.is_active) return 'Attiva'
  return 'Inattiva'
}
---

<AdminLayout title={isNew ? 'Nuova gift card' : `Gift card: ${card?.code ?? ''}`} active="gift-cards">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/gift-cards" class="breadcrumb-back">← Gift card</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px;font-family:monospace">{isNew ? 'Nuova gift card' : card?.code}</h1>
      {!isNew && (
        <span class:list={['badge', cardBadgeClass()]}>{cardBadgeLabel()}</span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <div class="stack stack-4">

    {isNew && (
      <form method="POST">
        <SectionCard title="Nuova gift card">
          <div class="form-grid">

            <div class="field">
              <label class="field-label" for="gc_code">Codice <span class="required">*</span></label>
              <input id="gc_code" class="field-input" name="code" required
                style="font-family:monospace;text-transform:uppercase" />
            </div>

            <div class="field">
              <label class="field-label" for="gc_initial">Valore iniziale (€) <span class="required">*</span></label>
              <input id="gc_initial" class="field-input" name="initial_value" type="number" step="0.01" min="0" required />
            </div>

            <div class="field">
              <label class="field-label" for="gc_expires">Scadenza</label>
              <input id="gc_expires" class="field-input" name="expires_at" type="datetime-local" style="width:auto" />
            </div>

            <div class="field">
              <label class="field-label" for="gc_active">Stato</label>
              <select id="gc_active" class="field-select" name="is_active">
                <option value="true">Attiva</option>
                <option value="false">Inattiva</option>
              </select>
            </div>

          </div>
        </SectionCard>
        <div class="form-actions" style="margin-top:16px">
          <button type="submit" class="btn btn-primary">Crea gift card</button>
        </div>
      </form>
    )}

    {!isNew && card && (
      <>
        <div class="kpi-bar">
          <div class="kpi-item">
            <div class="kpi-val">€{card.initial_value.toFixed(2)}</div>
            <div class="kpi-lbl">Valore iniziale</div>
          </div>
          <div class="kpi-item">
            <div class:list={['kpi-val', card.remaining_value === 0 && 'kpi-val--muted']}>
              €{card.remaining_value.toFixed(2)}
            </div>
            <div class="kpi-lbl">Saldo residuo</div>
          </div>
          <div class="kpi-item">
            <div class="kpi-val">{percentUsed}%</div>
            <div class="kpi-lbl">Utilizzata</div>
          </div>
        </div>

        <form method="POST">
          <SectionCard title="Impostazioni">
            <div class="form-grid">
              <div class="field">
                <label class="field-label" for="gc_edit_expires">Scadenza</label>
                <input id="gc_edit_expires" class="field-input" name="expires_at" type="datetime-local"
                  value={toDatetimeLocal(card.expires_at)} style="width:auto" />
              </div>
              <div class="field">
                <label class="field-label" for="gc_edit_active">Stato</label>
                <select id="gc_edit_active" class="field-select" name="is_active">
                  <option value="true" selected={card.is_active}>Attiva</option>
                  <option value="false" selected={!card.is_active}>Inattiva</option>
                </select>
              </div>
            </div>
          </SectionCard>
          <div class="form-actions" style="margin-top:16px">
            <button type="submit" class="btn btn-primary">Salva</button>
          </div>
        </form>

        <SectionCard title={`Storico utilizzi (${card.redemptions?.length ?? 0})`}>
          {!card.redemptions?.length
            ? <p class="empty-msg">Nessun utilizzo.</p>
            : (
              <div class="table-wrap" style="border:none;border-radius:0;margin:-16px">
                <table class="data-table" style="white-space:nowrap">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th style="text-align:right">Importo</th>
                      <th>Ordine</th>
                    </tr>
                  </thead>
                  <tbody>
                    {card.redemptions.map(r => (
                      <tr>
                        <td style="color:var(--c-ink-muted)">{fmtDate(r.date)}</td>
                        <td style="text-align:right;color:var(--c-danger);font-weight:500">-€{r.amount.toFixed(2)}</td>
                        <td>
                          <a href={`/admin/orders/${r.order_id}`}
                            style="color:var(--admin-accent);font-family:monospace;font-size:12px">
                            #{r.order_id.slice(0, 8)}
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )
          }
        </SectionCard>
      </>
    )}

  </div>

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .form-actions { display: flex; justify-content: flex-end; }
  .required { color: var(--c-danger); }
  .empty-msg { font-size: 14px; color: var(--c-ink-muted); }

  .kpi-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .kpi-item {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 16px 20px;
    text-align: center;
  }

  .kpi-val {
    font-size: 24px;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1;
  }

  .kpi-val--muted { color: var(--c-ink-subtle); }

  .kpi-lbl {
    font-size: 11px;
    color: var(--c-ink-muted);
    margin-top: 4px;
    font-weight: 500;
  }
</style>
