---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { ProductCategory } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/products/categories')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const payload = {
    name: formData.get('name'),
    slug: formData.get('slug'),
    description: formData.get('description') || null,
    parent_id: formData.get('parent_id') || null,
    sort_order: parseInt(String(formData.get('sort_order') ?? '0')),
    seo_title: formData.get('seo_title') || null,
    seo_description: formData.get('seo_description') || null,
  }
  if (isNew) {
    const result = await dFetch('/items/product_categories', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/products/categories/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const result = await dFetch(`/items/product_categories/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/products/categories/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio. Riprova.'
    }
  }
}

const allCatsRes = await dFetch('/items/product_categories?fields[]=id,name&sort[]=sort_order&limit=100')
const allCats = (allCatsRes?.data ?? []) as Array<{ id: string; name: string }>

let cat: (ProductCategory & { parent_id: string | null }) | null = null
if (!isNew) {
  const catRes = await dFetch(`/items/product_categories/${id}?fields[]=*`)
  if (!catRes?.data) return Astro.redirect('/admin/products/categories')
  cat = catRes.data as ProductCategory & { parent_id: string | null }
}

const saved = Astro.url.searchParams.get('saved') === '1'
---

<AdminLayout title={isNew ? 'Nuova categoria' : (cat?.name ?? '')} active="products">

  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/products" class="breadcrumb-back">← Prodotti</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <a href="/admin/products/categories" class="breadcrumb-back">Categorie</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{isNew ? 'Nuova categoria' : cat?.name}</h1>
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <form method="POST">
    <div class="stack stack-4">

      <SectionCard title="Informazioni categoria">
        <div class="stack stack-4">

          <div class="field">
            <label class="field-label" for="cat_name">Nome <span class="required">*</span></label>
            <input id="cat_name" class="field-input" name="name" required value={cat?.name ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="cat_slug">Slug <span class="required">*</span></label>
            <input id="cat_slug" class="field-input" name="slug" required value={cat?.slug ?? ''}
              style="font-family:monospace" />
          </div>

          <div class="field">
            <label class="field-label" for="cat_parent">Categoria parent</label>
            <select id="cat_parent" class="field-select" name="parent_id">
              <option value="">— nessuna —</option>
              {allCats.filter(c => c.id !== id).map(c => (
                <option value={c.id} selected={cat?.parent_id === c.id}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="cat_desc">Descrizione</label>
            <textarea id="cat_desc" class="field-textarea" name="description" rows={3}>{cat?.description ?? ''}</textarea>
          </div>

          <div class="field" style="max-width:160px">
            <label class="field-label" for="cat_sort">Ordine</label>
            <input id="cat_sort" class="field-input" name="sort_order" type="number" value={cat?.sort_order ?? 0} />
          </div>

        </div>
      </SectionCard>

      <SectionCard title="SEO">
        <div class="stack stack-4">
          <div class="field">
            <label class="field-label" for="cat_seo_title">SEO Title</label>
            <input id="cat_seo_title" class="field-input" name="seo_title" value={cat?.seo_title ?? ''} />
          </div>
          <div class="field">
            <label class="field-label" for="cat_seo_desc">SEO Description</label>
            <textarea id="cat_seo_desc" class="field-textarea" name="seo_description" rows={2}>{cat?.seo_description ?? ''}</textarea>
          </div>
        </div>
      </SectionCard>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {isNew ? 'Crea categoria' : 'Salva modifiche'}
        </button>
      </div>

    </div>
  </form>

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }
  .form-actions { display: flex; justify-content: flex-end; }
  .required { color: var(--c-danger); }
</style>
