---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Product } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/products')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const payload: Record<string, unknown> = {
    name: formData.get('name'),
    slug: formData.get('slug'),
    description: formData.get('description') || null,
    type: formData.get('type') ?? 'physical',
    base_price: parseFloat(String(formData.get('base_price') ?? '0')),
    compare_price: formData.get('compare_price') ? parseFloat(String(formData.get('compare_price'))) : null,
    category_id: formData.get('category_id') || null,
    weight_g: formData.get('weight_g') ? parseInt(String(formData.get('weight_g'))) : 0,
    featured: formData.get('featured') === 'true',
    status: formData.get('status') ?? 'draft',
    seo_title: formData.get('seo_title') || null,
    seo_description: formData.get('seo_description') || null,
    is_active: true,
  }
  if (isNew) {
    const result = await dFetch('/items/products', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) return Astro.redirect(`/admin/products/${result.data.id}?saved=1`)
    saveError = 'Errore durante la creazione.'
  } else {
    const result = await dFetch(`/items/products/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) return Astro.redirect(`/admin/products/${id}?saved=1`)
    saveError = 'Errore durante il salvataggio.'
  }
}

const allCatsRes = await dFetch('/items/product_categories?fields[]=id,name&sort[]=sort_order&limit=100')
const allCats = (allCatsRes?.data ?? []) as Array<{ id: string; name: string }>

let product: (Product & { category_id: { id: string; name: string } | null }) | null = null
if (!isNew) {
  const productRes = await dFetch(`/items/products/${id}?fields[]=*,variants.*,category_id.name,category_id.id`)
  if (!productRes?.data) return Astro.redirect('/admin/products')
  product = productRes.data as Product & { category_id: { id: string; name: string } | null }
}

const saved = Astro.url.searchParams.get('saved') === '1'
---

<AdminLayout title={isNew ? 'Nuovo prodotto' : (product?.name ?? '')} active="products">

  <!-- Breadcrumb -->
  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/products" class="breadcrumb-back">← Prodotti</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{isNew ? 'Nuovo prodotto' : product?.name}</h1>
      {!isNew && (
        <span class:list={['badge', product?.status === 'published' ? 'badge-success' : 'badge-neutral']}>
          {product?.status === 'published' ? 'Pubblicato' : 'Bozza'}
        </span>
      )}
    </div>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:16px">Salvato con successo.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:16px">{saveError}</div>}

  <form method="POST">
    <div class="stack stack-4">

      <SectionCard title="Informazioni prodotto">
        <div class="form-grid">

          <div class="field field-full">
            <label class="field-label" for="prod_name">Nome <span class="required">*</span></label>
            <input id="prod_name" class="field-input" name="name" required value={product?.name ?? ''} />
          </div>

          <div class="field field-full">
            <label class="field-label" for="prod_slug">Slug <span class="required">*</span></label>
            <input id="prod_slug" class="field-input" name="slug" required value={product?.slug ?? ''} style="font-family:monospace" />
          </div>

          <div class="field">
            <label class="field-label" for="base_price">Prezzo base (€) <span class="required">*</span></label>
            <input id="base_price" class="field-input" name="base_price" type="number" step="0.01" min="0" required value={product?.base_price ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="compare_price">Prezzo barrato (€)</label>
            <input id="compare_price" class="field-input" name="compare_price" type="number" step="0.01" min="0" value={product?.compare_price ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="category_id">Categoria</label>
            <select id="category_id" class="field-select" name="category_id">
              <option value="">— nessuna —</option>
              {allCats.map(c => (
                <option value={c.id} selected={
                  typeof product?.category_id === 'object'
                    ? product?.category_id?.id === c.id
                    : product?.category_id === c.id
                }>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="prod_type">Tipo</label>
            <select id="prod_type" class="field-select" name="type">
              <option value="physical" selected={!product || product.type === 'physical'}>Fisico</option>
              <option value="digital"  selected={product?.type === 'digital'}>Digitale</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="weight_g">Peso (g)</label>
            <input id="weight_g" class="field-input" name="weight_g" type="number" min="0" value={product?.weight_g ?? 0} />
          </div>

          <div class="field">
            <label class="field-label" for="prod_status">Stato</label>
            <select id="prod_status" class="field-select" name="status">
              <option value="draft"     selected={!product || product.status === 'draft'}>Bozza</option>
              <option value="published" selected={product?.status === 'published'}>Pubblicato</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="featured">In evidenza</label>
            <select id="featured" class="field-select" name="featured">
              <option value="false" selected={!product?.featured}>No</option>
              <option value="true"  selected={product?.featured === true}>Sì</option>
            </select>
          </div>

          <div class="field field-full">
            <label class="field-label" for="description">Descrizione</label>
            <textarea id="description" class="field-textarea" name="description" rows={4}>{product?.description ?? ''}</textarea>
          </div>

        </div>
      </SectionCard>

      <SectionCard title="SEO">
        <div class="stack stack-4">
          <div class="field">
            <label class="field-label" for="seo_title">SEO Title</label>
            <input id="seo_title" class="field-input" name="seo_title" value={product?.seo_title ?? ''} />
          </div>
          <div class="field">
            <label class="field-label" for="seo_description">SEO Description</label>
            <textarea id="seo_description" class="field-textarea" name="seo_description" rows={2}>{product?.seo_description ?? ''}</textarea>
          </div>
        </div>
      </SectionCard>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {isNew ? 'Crea prodotto' : 'Salva modifiche'}
        </button>
      </div>

    </div>
  </form>

  <!-- Variants (view mode) -->
  {!isNew && product && (
    <div style="margin-top:16px">
      <SectionCard title={`Varianti (${product.variants?.length ?? 0})`}>
        {!product.variants?.length
          ? <p class="empty-msg">Nessuna variante.</p>
          : (
            <div class="table-wrap" style="border:none;border-radius:0;margin:-16px">
              <table class="data-table" style="white-space:nowrap">
                <thead>
                  <tr>
                    <th>SKU</th>
                    <th>Nome</th>
                    <th>Opzione 1</th>
                    <th>Opzione 2</th>
                    <th style="text-align:right">Prezzo</th>
                    <th style="text-align:right">Stock</th>
                    <th style="text-align:center">Attiva</th>
                  </tr>
                </thead>
                <tbody>
                  {product.variants.map(v => (
                    <tr>
                      <td style="font-family:monospace;font-size:12px;color:var(--c-ink-muted)">{v.sku}</td>
                      <td style="font-weight:500">{v.name}</td>
                      <td style="color:var(--c-ink-muted)">{v.option_1_name ? `${v.option_1_name}: ${v.option_1_value}` : '—'}</td>
                      <td style="color:var(--c-ink-muted)">{v.option_2_name ? `${v.option_2_name}: ${v.option_2_value}` : '—'}</td>
                      <td style="text-align:right">{v.price_override != null ? `€${v.price_override.toFixed(2)}` : '—'}</td>
                      <td style="text-align:right">
                        <span style={v.stock_quantity <= v.low_stock_threshold ? 'color:var(--c-warning);font-weight:600' : ''}>
                          {v.stock_quantity}
                        </span>
                      </td>
                      <td style="text-align:center">
                        <span style={v.is_active ? 'color:var(--c-success)' : 'color:var(--c-border-2)'}>●</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </SectionCard>
    </div>
  )}

</AdminLayout>

<style>
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .breadcrumb-back:hover { color: var(--c-ink); }
  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }

  .form-actions { display: flex; justify-content: flex-end; }
  .empty-msg { font-size: 14px; color: var(--c-ink-muted); }
  .required { color: var(--c-danger); }
</style>
