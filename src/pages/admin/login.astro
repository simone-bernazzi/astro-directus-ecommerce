---
// src/pages/admin/login.astro — admin password gate
export const prerender = true

import Base from '@/layouts/Base.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
---

<Base title="Admin — Accesso">
  <Header />
  <main class="container py-16 max-w-sm mx-auto">
    <div class="bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] p-8">
      <h1 class="text-xl font-bold mb-6">Accesso admin</h1>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5" for="admin-password">Password</label>
          <input
            id="admin-password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2.5 border border-[var(--color-border)] rounded-lg bg-[var(--color-bg)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand)] focus:border-transparent"
          />
        </div>
        <p id="admin-error" class="hidden text-sm text-red-600"></p>
        <button
          type="submit"
          id="admin-login-btn"
          class="w-full py-2.5 bg-[var(--color-brand)] text-white font-medium rounded-lg hover:opacity-90 transition-opacity"
        >
          Accedi
        </button>
      </form>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const form = document.getElementById('admin-login-form') as HTMLFormElement
  const errorEl = document.getElementById('admin-error')!
  const btn = document.getElementById('admin-login-btn') as HTMLButtonElement

  form.addEventListener('submit', async e => {
    e.preventDefault()
    errorEl.classList.add('hidden')
    btn.disabled = true
    btn.textContent = 'Verifica…'

    const password = (document.getElementById('admin-password') as HTMLInputElement).value

    try {
      const res = await fetch('/api/admin/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      })

      if (res.ok) {
        window.location.href = '/admin'
      } else {
        const data = await res.json()
        errorEl.textContent = data.error ?? 'Password non valida.'
        errorEl.classList.remove('hidden')
        btn.disabled = false
        btn.textContent = 'Accedi'
      }
    } catch {
      errorEl.textContent = 'Errore di rete. Riprova.'
      errorEl.classList.remove('hidden')
      btn.disabled = false
      btn.textContent = 'Accedi'
    }
  })
</script>
