---
export const prerender = false
import '../../styles/admin.css'

import type { AstroGlobal } from 'astro'
const { cookies, redirect, url } = Astro as AstroGlobal

if (cookies.get('admin_token')?.value) {
  const dest = url.searchParams.get('redirect') || '/admin'
  return redirect(dest)
}
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accesso — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="login-screen">
      <div class="login-card">
        <!-- Brand -->
        <div class="login-brand">
          <span class="brand-monogram" aria-hidden="true">OM</span>
          <div class="brand-text">
            <span class="brand-name">Ottica Marangon</span>
            <span class="brand-sub">Pannello amministrativo</span>
          </div>
        </div>

        <form id="login-form" novalidate>
          <input type="hidden" id="redirect-field" name="redirect" value="" />

          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input
              class="field-input"
              id="email"
              type="email"
              name="email"
              required
              autocomplete="username"
              placeholder="amministratore@otticamarangon.it"
            />
          </div>

          <div class="field">
            <label class="field-label" for="password">Password</label>
            <input
              class="field-input"
              id="password"
              type="password"
              name="password"
              required
              autocomplete="current-password"
            />
          </div>

          <p id="error-msg" class="login-error" role="alert" aria-live="polite" hidden></p>

          <button type="submit" id="submit-btn" class="btn btn-primary" style="width:100%;margin-top:8px">
            Accedi
          </button>
        </form>
      </div>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search)
      const redirectTo = params.get('redirect') || '/admin'
      ;(document.getElementById('redirect-field') as HTMLInputElement).value = redirectTo

      const form = document.getElementById('login-form') as HTMLFormElement
      const errorEl = document.getElementById('error-msg') as HTMLParagraphElement
      const btn = document.getElementById('submit-btn') as HTMLButtonElement

      function showError(msg: string) {
        errorEl.textContent = msg
        errorEl.hidden = false
      }

      function clearError() {
        errorEl.hidden = true
        errorEl.textContent = ''
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        clearError()

        const email = (document.getElementById('email') as HTMLInputElement).value.trim()
        const password = (document.getElementById('password') as HTMLInputElement).value

        if (!email || !password) {
          showError('Inserisci email e password.')
          return
        }

        btn.disabled = true
        btn.textContent = 'Accesso in corso…'

        try {
          const res = await fetch('/api/admin/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          })

          if (res.ok) {
            window.location.href = redirectTo
          } else {
            const data = await res.json().catch(() => ({}))
            showError((data as { error?: string }).error ?? 'Credenziali non valide.')
            btn.disabled = false
            btn.textContent = 'Accedi'
          }
        } catch {
          showError('Errore di rete. Riprova.')
          btn.disabled = false
          btn.textContent = 'Accedi'
        }
      })
    </script>
  </body>
</html>

<style>
  :root {
    --admin-accent: oklch(0.528 0.214 264);
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--c-bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: var(--c-ink);
    -webkit-font-smoothing: antialiased;
  }

  .login-screen {
    width: 100%;
    max-width: 400px;
  }

  .login-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-xl);
    padding: 36px 32px;
    box-shadow: var(--shadow-md);
  }

  .login-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .brand-monogram {
    width: 40px;
    height: 40px;
    background: var(--admin-accent);
    color: #fff;
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    font-family: 'Inter', sans-serif;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1.2;
  }

  .brand-sub {
    font-size: 12px;
    color: var(--c-ink-muted);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .login-error {
    font-size: 13px;
    color: var(--c-danger);
    background: var(--c-danger-bg);
    border: 1px solid color-mix(in oklch, var(--c-danger) 25%, transparent);
    border-radius: var(--r-md);
    padding: 10px 14px;
    margin-bottom: 12px;
    line-height: 1.4;
  }

  /* btn classes come from admin.css */
</style>
