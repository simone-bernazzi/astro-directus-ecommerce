---
export const prerender = false
import AdminLayout from '@/layouts/AdminLayout.astro'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const directusToken = Astro.cookies.get('admin_token')?.value ?? ''

type OrderRow = { id: string; status: string; customer_email: string; total: number; date_created: string }
type VariantRow = { id: string; sku: string; name: string; stock_quantity: number; product_id: { name: string } }

async function dFetch(path: string) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      headers: { Authorization: `Bearer ${directusToken}` },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

const lowStockThreshold = parseInt(process.env.ADMIN_LOW_STOCK_THRESHOLD ?? '5')

const [ordersAgg, revenueAgg, recentOrdersRes, lowStockRes, pendingOrdersRes] = await Promise.all([
  dFetch('/items/orders?aggregate[count]=id'),
  dFetch('/items/orders?aggregate[sum]=total&filter[status][_in]=paid,shipped,delivered'),
  dFetch('/items/orders?sort[]=-date_created&limit=10&fields[]=id&fields[]=status&fields[]=customer_email&fields[]=total&fields[]=date_created'),
  dFetch(`/items/product_variants?filter[stock_quantity][_lte]=${lowStockThreshold}&filter[is_active][_eq]=true&fields[]=id&fields[]=sku&fields[]=name&fields[]=stock_quantity&fields[]=product_id.name&sort[]=stock_quantity&limit=20`),
  dFetch('/items/orders?aggregate[count]=id&filter[status][_eq]=paid'),
])

const totalOrders  = (ordersAgg?.data?.[0]?.count?.id ?? 0) as number
const totalRevenue = parseFloat(revenueAgg?.data?.[0]?.sum?.total ?? '0')
const recentOrders = (recentOrdersRes?.data ?? []) as OrderRow[]
const lowStock     = (lowStockRes?.data ?? []) as VariantRow[]
const pendingCount = (pendingOrdersRes?.data?.[0]?.count?.id ?? 0) as number

const STATUS_LABELS: Record<string, string> = {
  pending: 'In attesa', paid: 'Pagato', shipped: 'Spedito',
  delivered: 'Consegnato', refunded: 'Rimborsato',
}

function statusBadgeClass(s: string) {
  return { pending: 'badge-warning', paid: 'badge-info', shipped: 'badge-info',
    delivered: 'badge-success', refunded: 'badge-neutral' }[s] ?? 'badge-neutral'
}

function fmtDate(iso: string) {
  return new Date(iso).toLocaleString('it-IT', {
    day: '2-digit', month: '2-digit', year: '2-digit',
    hour: '2-digit', minute: '2-digit',
  })
}

function fmtCurrency(n: number) {
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n)
}
---

<AdminLayout title="Dashboard" active="dashboard">

  <!-- KPI cards -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <p class="kpi-label">Ordini totali</p>
      <p class="kpi-value">{totalOrders}</p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Fatturato incassato</p>
      <p class="kpi-value">{fmtCurrency(totalRevenue)}</p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Da processare</p>
      <p class="kpi-value" class:list={[pendingCount > 0 && 'kpi-value--alert']}>{pendingCount}</p>
    </div>
    <div class="kpi-card">
      <p class="kpi-label">Stock in esaurimento</p>
      <p class="kpi-value" class:list={[lowStock.length > 0 && 'kpi-value--danger']}>{lowStock.length}</p>
    </div>
  </div>

  <div class="dash-grid">

    <!-- Recent orders -->
    <div class="panel" style="padding:0;overflow:hidden">
      <div class="panel-head">
        <span class="panel-head-title">Ultimi ordini</span>
        <a href="/admin/orders" class="panel-head-link">Vedi tutti</a>
      </div>
      {recentOrders.length === 0
        ? <p class="empty-row">Nessun ordine.</p>
        : (
          <div class="table-wrap" style="border:none;border-radius:0">
            <table class="data-table" style="white-space:nowrap">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Stato</th>
                  <th>Cliente</th>
                  <th style="text-align:right">Totale</th>
                  <th style="text-align:right">Data</th>
                </tr>
              </thead>
              <tbody>
                {recentOrders.map(o => (
                  <tr>
                    <td style="font-family:monospace;font-size:12px;color:var(--c-ink-muted)">{o.id.slice(0, 8)}…</td>
                    <td><span class:list={['badge', statusBadgeClass(o.status)]}>{STATUS_LABELS[o.status] ?? o.status}</span></td>
                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis">{o.customer_email}</td>
                    <td style="text-align:right;font-weight:500">{fmtCurrency(o.total ?? 0)}</td>
                    <td style="text-align:right;color:var(--c-ink-muted);font-size:12px">{fmtDate(o.date_created)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

    <!-- Right column -->
    <div class="dash-sidebar">

      <!-- Low stock -->
      <div class="panel" style="padding:0;overflow:hidden">
        <div class="panel-head">
          <span class="panel-head-title">Stock in esaurimento <span style="font-weight:400;color:var(--c-ink-muted)">(≤{lowStockThreshold})</span></span>
        </div>
        {lowStock.length === 0
          ? <p class="empty-row">Nessuna variante in esaurimento.</p>
          : (
            <ul class="stock-list">
              {lowStock.map(v => (
                <li class="stock-item">
                  <div class="stock-info">
                    <p class="stock-name">{v.product_id?.name ?? '—'}</p>
                    <p class="stock-sku">{v.name} · {v.sku}</p>
                  </div>
                  <span class:list={['badge', v.stock_quantity === 0 ? 'badge-danger' : 'badge-warning']}>
                    {v.stock_quantity}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Quick links -->
      <div class="panel">
        <p class="panel-title">Accesso rapido</p>
        <div class="quick-links">
          <a href="/admin/contacts/new" class="btn btn-secondary" style="justify-content:flex-start">+ Nuovo contatto</a>
          <a href="/admin/orders/new" class="btn btn-secondary" style="justify-content:flex-start">+ Ordine offline</a>
          <a href="/admin/products/new" class="btn btn-secondary" style="justify-content:flex-start">+ Nuovo prodotto</a>
        </div>
      </div>

    </div>
  </div>

</AdminLayout>

<style>
  /* KPI grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  @media (min-width: 900px) {
    .kpi-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .kpi-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 20px;
  }

  .kpi-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--c-ink-muted);
    margin-bottom: 8px;
  }

  .kpi-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--c-ink);
    line-height: 1;
  }

  .kpi-value--alert { color: var(--c-info); }
  .kpi-value--danger { color: var(--c-danger); }

  /* Dashboard grid */
  .dash-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .dash-grid { grid-template-columns: 1fr 320px; }
  }

  .dash-sidebar { display: flex; flex-direction: column; gap: 20px; }

  /* Panel head */
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface-2);
  }

  .panel-head-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--c-ink);
  }

  .panel-head-link {
    font-size: 12px;
    color: var(--admin-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .panel-head-link:hover { text-decoration: underline; }

  .empty-row {
    padding: 24px 20px;
    font-size: 13px;
    color: var(--c-ink-muted);
  }

  /* Stock list */
  .stock-list {
    list-style: none;
  }

  .stock-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--c-border);
  }

  .stock-item:last-child { border-bottom: none; }

  .stock-info { min-width: 0; }

  .stock-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--c-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stock-sku {
    font-size: 11px;
    color: var(--c-ink-muted);
    margin-top: 2px;
  }

  /* Quick links */
  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
