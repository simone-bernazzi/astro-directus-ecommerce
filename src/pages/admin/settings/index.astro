---
// src/pages/admin/settings/index.astro
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        ...((opts?.headers as Record<string, string>) ?? {}),
      },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

const FIELDS = [
  'site_name', 'footer_text',
  'contact_email', 'contact_phone', 'contact_address', 'vat_number',
  'social_instagram', 'social_facebook', 'social_tiktok', 'social_youtube',
  'accent_color', 'icon_color',
  'seo_description_default',
]

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const payload: Record<string, string | null> = {}
  for (const f of FIELDS) {
    const v = formData.get(f)
    payload[f] = v ? String(v) : null
  }
  const result = await dFetch('/items/site_settings/1', { method: 'PATCH', body: JSON.stringify(payload) })
  if (result) {
    return Astro.redirect('/admin/settings?saved=1')
  } else {
    saveError = 'Errore durante il salvataggio.'
  }
}

const settingsRes = await dFetch('/items/site_settings/1?fields[]=*')
const settings = (settingsRes?.data ?? {}) as Record<string, unknown>
const saved = Astro.url.searchParams.get('saved') === '1'

function str(key: string) { return String(settings[key] ?? '') }
---

<AdminLayout title="Impostazioni" active="settings">

  <div class="page-header">
    <h1 class="page-title">Impostazioni sito</h1>
  </div>

  {saved && <div class="alert alert-success" style="margin-bottom:var(--s-4)">Impostazioni salvate.</div>}
  {saveError && <div class="alert alert-danger" style="margin-bottom:var(--s-4)">{saveError}</div>}

  <form method="POST">
    <div class="stack stack-4" style="max-width:680px">

      <!-- ── Informazioni sito ── -->
      <SectionCard title="Informazioni sito">
        <div class="stack stack-4">
          <div class="field">
            <label class="field-label" for="site_name">Nome sito</label>
            <input id="site_name" class="field-input" name="site_name" value={str('site_name')} />
          </div>
          <div class="field">
            <label class="field-label" for="footer_text">Testo footer</label>
            <textarea id="footer_text" class="field-textarea" name="footer_text" rows={3}>{str('footer_text')}</textarea>
          </div>
        </div>
      </SectionCard>

      <!-- ── Recapiti ── -->
      <SectionCard title="Recapiti">
        <div class="form-grid">
          <div class="field">
            <label class="field-label" for="contact_email">Email di contatto</label>
            <input id="contact_email" class="field-input" name="contact_email" type="email" value={str('contact_email')} />
          </div>
          <div class="field">
            <label class="field-label" for="contact_phone">Telefono</label>
            <input id="contact_phone" class="field-input" name="contact_phone" type="tel" value={str('contact_phone')} />
          </div>
          <div class="field field-full">
            <label class="field-label" for="contact_address">Indirizzo</label>
            <textarea id="contact_address" class="field-textarea" name="contact_address" rows={2}>{str('contact_address')}</textarea>
          </div>
          <div class="field">
            <label class="field-label" for="vat_number">Partita IVA</label>
            <input id="vat_number" class="field-input" name="vat_number" value={str('vat_number')} />
          </div>
        </div>
      </SectionCard>

      <!-- ── Social ── -->
      <SectionCard title="Social">
        <div class="form-grid">
          <div class="field">
            <label class="field-label" for="social_instagram">Instagram</label>
            <input id="social_instagram" class="field-input" name="social_instagram" placeholder="https://instagram.com/…" value={str('social_instagram')} />
          </div>
          <div class="field">
            <label class="field-label" for="social_facebook">Facebook</label>
            <input id="social_facebook" class="field-input" name="social_facebook" placeholder="https://facebook.com/…" value={str('social_facebook')} />
          </div>
          <div class="field">
            <label class="field-label" for="social_tiktok">TikTok</label>
            <input id="social_tiktok" class="field-input" name="social_tiktok" placeholder="https://tiktok.com/@…" value={str('social_tiktok')} />
          </div>
          <div class="field">
            <label class="field-label" for="social_youtube">YouTube</label>
            <input id="social_youtube" class="field-input" name="social_youtube" placeholder="https://youtube.com/@…" value={str('social_youtube')} />
          </div>
        </div>
      </SectionCard>

      <!-- ── Brand e colori ── -->
      <SectionCard title="Brand e colori">
        <p class="field-hint" style="margin-bottom:var(--s-4)">
          I colori modificano in tempo reale il pannello admin. Il valore viene salvato in hex.
        </p>
        <div class="form-grid">

          <div class="field">
            <label class="field-label" for="accent-input">Colore accent</label>
            <span class="field-hint">Pulsanti, link attivi, indicatori</span>
            <div class="color-row">
              <input type="color" id="accent-input" name="accent_color" class="color-picker" value="#6366f1" />
              <div>
                <div id="accent-preview" class="color-preview"></div>
                <code id="accent-hex" class="color-hex"></code>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="icon-input">Colore icone sidebar</label>
            <span class="field-hint">Icone e testo degli elementi inattivi</span>
            <div class="color-row">
              <input type="color" id="icon-input" name="icon_color" class="color-picker" value="#6b7280" />
              <div>
                <div id="icon-preview" class="color-preview"></div>
                <code id="icon-hex" class="color-hex"></code>
              </div>
            </div>
          </div>

        </div>
      </SectionCard>

      <!-- ── SEO ── -->
      <SectionCard title="SEO">
        <div class="field">
          <label class="field-label" for="seo_description_default">Meta description di default</label>
          <textarea id="seo_description_default" class="field-textarea" name="seo_description_default" rows={3} maxlength={160} placeholder="Descrizione usata per le pagine senza SEO personalizzato (max 160 caratteri)">{str('seo_description_default')}</textarea>
          <span class="field-hint">Usata per le pagine prive di SEO personalizzato.</span>
        </div>
      </SectionCard>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salva impostazioni</button>
      </div>

    </div>
  </form>

</AdminLayout>

<script>
  function cssColorToHex(cssColor: string): string | null {
    if (!cssColor) return null
    try {
      const canvas = document.createElement('canvas')
      canvas.width = canvas.height = 1
      const ctx = canvas.getContext('2d')!
      ctx.fillStyle = '#000000'
      ctx.fillStyle = cssColor.trim()
      const hex = ctx.fillStyle
      return hex.startsWith('#') ? hex : null
    } catch { return null }
  }

  const accentInput = document.getElementById('accent-input') as HTMLInputElement | null
  const accentPreview = document.getElementById('accent-preview')
  const accentHexEl = document.getElementById('accent-hex')

  const iconInput = document.getElementById('icon-input') as HTMLInputElement | null
  const iconPreview = document.getElementById('icon-preview')
  const iconHexEl = document.getElementById('icon-hex')

  function applyColor(input: HTMLInputElement, preview: Element | null, hexEl: Element | null, color: string) {
    input.value = color
    if (preview) (preview as HTMLElement).style.background = color
    if (hexEl) hexEl.textContent = color
  }

  // Read live CSS variables (already set by AdminLayout from Directus)
  const styles = getComputedStyle(document.documentElement)
  const storedAccent = styles.getPropertyValue('--admin-accent').trim()
  const storedIcon = styles.getPropertyValue('--admin-icon-color').trim()

  if (accentInput) {
    const hex = cssColorToHex(storedAccent)
    applyColor(accentInput, accentPreview, accentHexEl, hex ?? accentInput.value)
  }

  if (iconInput) {
    const hex = storedIcon ? cssColorToHex(storedIcon) : null
    // Fallback: read --c-ink-muted if no icon_color stored yet
    const fallbackHex = cssColorToHex(styles.getPropertyValue('--c-ink-muted').trim())
    applyColor(iconInput, iconPreview, iconHexEl, hex ?? fallbackHex ?? iconInput.value)
  }

  accentInput?.addEventListener('input', () => {
    const color = accentInput!.value
    if (accentPreview) (accentPreview as HTMLElement).style.background = color
    if (accentHexEl) accentHexEl.textContent = color
    document.documentElement.style.setProperty('--admin-accent', color)
  })

  iconInput?.addEventListener('input', () => {
    const color = iconInput!.value
    if (iconPreview) (iconPreview as HTMLElement).style.background = color
    if (iconHexEl) iconHexEl.textContent = color
    document.documentElement.style.setProperty('--admin-icon-color', color)
  })
</script>

<style>
  .form-actions { display: flex; justify-content: flex-end; }

  .color-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: var(--s-2);
  }

  .color-picker {
    width: 48px;
    height: 48px;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 4px;
    cursor: pointer;
    background: var(--c-surface);
    flex-shrink: 0;
  }

  .color-preview {
    width: 120px;
    height: 32px;
    border-radius: var(--r-md);
    border: 1px solid var(--c-border);
    background: var(--c-surface-2);
  }

  .color-hex {
    font-size: 12px;
    color: var(--c-ink-muted);
    margin-top: 4px;
    display: block;
  }
</style>
