---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Contact, Order, CrmInteraction, CrmTask, CustomerKpi } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/contacts')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
        ...((opts?.headers as Record<string, string>) ?? {}),
      },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const action = formData.get('_action') ?? 'contact'

  if (action === 'upload_document') {
    const file = formData.get('file') as File | null
    if (file && file.size > 0) {
      const label = (formData.get('label') as string) || file.name
      const uploadForm = new FormData()
      uploadForm.append('file', file, file.name)
      uploadForm.append('title', label)
      const uploadRes = await fetch(`${directusUrl}/files`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: uploadForm,
      }).catch(() => null)
      if (uploadRes?.ok) {
        const { data: fd } = await uploadRes.json() as { data: { id: string } }
        await dFetch('/items/contact_documents', {
          method: 'POST',
          body: JSON.stringify({ contact_id: id, directus_file_id: fd.id, label }),
        })
      }
    }
    return Astro.redirect(`/admin/contacts/${id}#documents`)
  }

  if (action === 'delete_document') {
    const docId = formData.get('doc_id') as string
    const fileId = formData.get('file_id') as string
    if (docId) await dFetch(`/items/contact_documents/${docId}`, { method: 'DELETE' })
    if (fileId) await dFetch(`/files/${fileId}`, { method: 'DELETE' })
    return Astro.redirect(`/admin/contacts/${id}#documents`)
  }

  if (action === 'add_interaction') {
    await dFetch('/items/crm_interactions', {
      method: 'POST',
      body: JSON.stringify({
        contact_id: id,
        type: formData.get('type') ?? 'note',
        date: formData.get('date') || new Date().toISOString(),
        subject: formData.get('subject') || null,
        body: formData.get('body') || null,
        outcome: formData.get('outcome') || null,
      }),
    })
    return Astro.redirect(`/admin/contacts/${id}#crm`)
  }

  if (action === 'add_task') {
    await dFetch('/items/crm_tasks', {
      method: 'POST',
      body: JSON.stringify({
        contact_id: id,
        title: formData.get('title'),
        due_date: formData.get('due_date') || null,
        status: formData.get('status') ?? 'todo',
        priority: formData.get('priority') ?? 'medium',
        notes: formData.get('notes') || null,
      }),
    })
    return Astro.redirect(`/admin/contacts/${id}#tasks`)
  }

  // Default: save contact
  const payload = {
    first_name: formData.get('first_name'),
    last_name: formData.get('last_name'),
    email: formData.get('email') || null,
    phone: formData.get('phone') || null,
    date_of_birth: formData.get('date_of_birth') || null,
    pipeline_stage: formData.get('pipeline_stage') ?? 'lead',
    canale_prevalente: formData.get('canale_prevalente') ?? 'offline',
    channel_type: formData.get('channel_type') ?? 'offline',
    is_active: formData.get('is_active') === 'true',
  }
  if (isNew) {
    const result = await dFetch('/items/contacts', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) return Astro.redirect(`/admin/contacts/${result.data.id}?saved=1`)
    saveError = 'Errore durante la creazione.'
  } else {
    const result = await dFetch(`/items/contacts/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) return Astro.redirect(`/admin/contacts/${id}?saved=1`)
    saveError = 'Errore durante il salvataggio.'
  }
}

type ContactDocument = {
  id: string
  label: string | null
  date_created: string | null
  directus_file_id: string | null
}

let contact: Contact | null = null
let orders: Partial<Order>[] = []
let interactions: Partial<CrmInteraction>[] = []
let tasks: Partial<CrmTask>[] = []
let kpi: Partial<CustomerKpi> | null = null
let documents: ContactDocument[] = []

if (!isNew) {
  const [contactRes, ordersRes, interactionsRes, tasksRes, kpiRes, docsRes] = await Promise.all([
    dFetch(`/items/contacts/${id}?fields[]=*`),
    dFetch(`/items/orders?filter[contact_id][_eq]=${id}&fields[]=id,status,total,date_created,channel&sort[]=-date_created&limit=20`),
    dFetch(`/items/crm_interactions?filter[contact_id][_eq]=${id}&fields[]=id,type,date,subject,body&sort[]=-date&limit=20`),
    dFetch(`/items/crm_tasks?filter[contact_id][_eq]=${id}&fields[]=id,title,due_date,status,priority&sort[]=due_date&limit=20`),
    dFetch(`/items/customer_kpis?filter[contact_id][_eq]=${id}&limit=1`),
    dFetch(`/items/contact_documents?filter[contact_id][_eq]=${id}&fields[]=id,label,date_created,directus_file_id&sort[]=-date_created&limit=50`),
  ])
  if (!contactRes?.data) return Astro.redirect('/admin/contacts')
  contact = contactRes.data as Contact
  orders = (ordersRes?.data ?? []) as Partial<Order>[]
  interactions = (interactionsRes?.data ?? []) as Partial<CrmInteraction>[]
  tasks = (tasksRes?.data ?? []) as Partial<CrmTask>[]
  kpi = (kpiRes?.data?.[0] ?? null) as Partial<CustomerKpi> | null
  documents = (docsRes?.data ?? []) as ContactDocument[]
}

const saved = Astro.url.searchParams.get('saved') === '1'
const fullName = isNew ? 'Nuovo contatto' : `${contact?.first_name ?? ''} ${contact?.last_name ?? ''}`.trim()

const PIPELINE_LABELS: Record<string, string> = {
  lead: 'Lead', prospect: 'Prospect', cliente_attivo: 'Attivo',
  cliente_fidelizzato: 'Fidelizzato', inattivo: 'Inattivo',
}
const PIPELINE_BADGE: Record<string, string> = {
  lead: 'badge-warning', prospect: 'badge-warning',
  cliente_attivo: 'badge-success', cliente_fidelizzato: 'badge-success', inattivo: 'badge-neutral',
}
const ORDER_STATUS_LABELS: Record<string, string> = {
  pending: 'In attesa', paid: 'Pagato', shipped: 'Spedito',
  delivered: 'Consegnato', refunded: 'Rimborsato',
}
const ORDER_STATUS_BADGE: Record<string, string> = {
  pending: 'badge-warning', paid: 'badge-info', shipped: 'badge-info',
  delivered: 'badge-success', refunded: 'badge-neutral',
}
const TASK_PRIORITY_BADGE: Record<string, string> = {
  high: 'badge-danger', medium: 'badge-warning', low: 'badge-neutral',
}
const TASK_STATUS_BADGE: Record<string, string> = {
  done: 'badge-success', in_progress: 'badge-info', todo: 'badge-neutral',
}
const TASK_STATUS_LABELS: Record<string, string> = {
  todo: 'Da fare', in_progress: 'In corso', done: 'Fatto',
}
const PRIORITY_LABELS: Record<string, string> = {
  low: 'Bassa', medium: 'Media', high: 'Alta',
}

function fmtDate(iso: string | null | undefined) {
  if (!iso) return '—'
  return new Date(iso).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: '2-digit' })
}

function toDateInput(iso: string | null | undefined): string {
  if (!iso) return ''
  return iso.slice(0, 10)
}

function fmtCurrency(n: number) {
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(n)
}
---

<AdminLayout title={fullName} active="contacts">

  <!-- Breadcrumb + title -->
  <div class="page-header">
    <div class="breadcrumb-row">
      <a href="/admin/contacts" class="breadcrumb-back">← Contatti</a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <h1 class="page-title" style="font-size:18px">{fullName}</h1>
      {!isNew && contact && (
        <span class:list={['badge', PIPELINE_BADGE[contact.pipeline_stage] ?? 'badge-neutral']}>
          {PIPELINE_LABELS[contact.pipeline_stage] ?? contact.pipeline_stage}
        </span>
      )}
    </div>
  </div>

  {saved && (
    <div class="alert alert-success" style="margin-bottom:16px">
      Salvato con successo.
    </div>
  )}
  {saveError && (
    <div class="alert alert-danger" style="margin-bottom:16px">
      {saveError}
    </div>
  )}

  <div class="stack stack-4">

    <!-- KPI bar -->
    {!isNew && kpi && (
      <div class="kpi-bar">
        <div class="kpi-item">
          <span class="kpi-val">{fmtCurrency(kpi.clv ?? 0)}</span>
          <span class="kpi-lbl">Valore cliente</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-val">{(kpi.total_orders_online ?? 0) + (kpi.total_orders_offline ?? 0)}</span>
          <span class="kpi-lbl">Ordini totali</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-val">{fmtCurrency((kpi.total_spent_online ?? 0) + (kpi.total_spent_offline ?? 0))}</span>
          <span class="kpi-lbl">Totale speso</span>
        </div>
        <div class="kpi-item">
          <span class="kpi-val">{fmtDate(kpi.last_purchase_at)}</span>
          <span class="kpi-lbl">Ultimo acquisto</span>
        </div>
      </div>
    )}

    <!-- Anagrafica -->
    <form method="POST">
      <SectionCard title="Anagrafica">
        <div class="form-grid">

          <div class="field">
            <label class="field-label" for="first_name">Nome <span class="required">*</span></label>
            <input id="first_name" class="field-input" name="first_name" required value={contact?.first_name ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="last_name">Cognome <span class="required">*</span></label>
            <input id="last_name" class="field-input" name="last_name" required value={contact?.last_name ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="email">Email</label>
            <input id="email" class="field-input" name="email" type="email" value={contact?.email ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="phone">Telefono</label>
            <input id="phone" class="field-input" name="phone" type="tel" value={contact?.phone ?? ''} />
          </div>

          <div class="field">
            <label class="field-label" for="date_of_birth">Data di nascita</label>
            <input id="date_of_birth" class="field-input" name="date_of_birth" type="date" value={toDateInput(contact?.date_of_birth)} />
          </div>

          <div class="field">
            <label class="field-label" for="pipeline_stage">Stage pipeline</label>
            <select id="pipeline_stage" class="field-select" name="pipeline_stage">
              <option value="lead"               selected={!contact || contact.pipeline_stage === 'lead'}>Lead</option>
              <option value="prospect"           selected={contact?.pipeline_stage === 'prospect'}>Prospect</option>
              <option value="cliente_attivo"     selected={contact?.pipeline_stage === 'cliente_attivo'}>Attivo</option>
              <option value="cliente_fidelizzato" selected={contact?.pipeline_stage === 'cliente_fidelizzato'}>Fidelizzato</option>
              <option value="inattivo"           selected={contact?.pipeline_stage === 'inattivo'}>Inattivo</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="canale_prevalente">Canale prevalente</label>
            <select id="canale_prevalente" class="field-select" name="canale_prevalente">
              <option value="offline" selected={!contact || contact.canale_prevalente === 'offline'}>Offline</option>
              <option value="online"  selected={contact?.canale_prevalente === 'online'}>Online</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="channel_type">Tipo canale</label>
            <select id="channel_type" class="field-select" name="channel_type">
              <option value="offline" selected={!contact || contact.channel_type === 'offline'}>Offline</option>
              <option value="online"  selected={contact?.channel_type === 'online'}>Online</option>
              <option value="both"    selected={contact?.channel_type === 'both'}>Entrambi</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="is_active">Stato</label>
            <select id="is_active" class="field-select" name="is_active">
              <option value="true"  selected={contact?.is_active ?? true}>Attivo</option>
              <option value="false" selected={contact ? !contact.is_active : false}>Inattivo</option>
            </select>
          </div>

          {!isNew && contact?.stripe_customer_id && (
            <div class="field field-full">
              <label class="field-label">Stripe ID</label>
              <code class="stripe-id">{contact.stripe_customer_id}</code>
            </div>
          )}

        </div>
      </SectionCard>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {isNew ? 'Crea contatto' : 'Salva modifiche'}
        </button>
      </div>
    </form>

    <!-- CRM sections (edit only) -->
    {!isNew && contact && <>

      <!-- Ordini -->
      <SectionCard title={`Ordini (${orders.length})`}>
        {orders.length === 0
          ? <p class="empty-msg">Nessun ordine registrato.</p>
          : (
            <div class="table-wrap" style="border:none;border-radius:0;margin:-16px">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Stato</th>
                    <th style="text-align:right">Totale</th>
                    <th>Data</th>
                    <th>Canale</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {orders.map(o => (
                    <tr>
                      <td style="font-family:monospace;font-size:12px;color:var(--c-ink-muted)">{String(o.id ?? '').slice(0, 8)}…</td>
                      <td><span class:list={['badge', ORDER_STATUS_BADGE[o.status ?? ''] ?? 'badge-neutral']}>{ORDER_STATUS_LABELS[o.status ?? ''] ?? o.status}</span></td>
                      <td style="text-align:right;font-weight:500">{fmtCurrency(o.total ?? 0)}</td>
                      <td style="color:var(--c-ink-muted)">{fmtDate(o.date_created)}</td>
                      <td style="color:var(--c-ink-muted)">{o.channel ?? '—'}</td>
                      <td style="text-align:center">
                        <a href={`/admin/orders/${o.id}`} class="table-link" aria-label="Apri ordine">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </SectionCard>

      <!-- Note CRM -->
      <div id="crm">
        <SectionCard title={`Note CRM (${interactions.length})`}>
          {interactions.length > 0 && (
            <div class="crm-list">
              {interactions.map(i => (
                <div class="crm-item">
                  <div class="crm-item-meta">
                    <span class="badge badge-neutral">{i.type}</span>
                    <span class="crm-date">{fmtDate(i.date)}</span>
                    {i.subject && <span class="crm-subject">{i.subject}</span>}
                  </div>
                  {i.body && <p class="crm-body">{i.body}</p>}
                </div>
              ))}
            </div>
          )}

          <form method="POST" class="inline-form">
            <input type="hidden" name="_action" value="add_interaction" />
            <p class="inline-form-title">Nuova interazione</p>
            <div class="form-grid-3">
              <div class="field">
                <label class="field-label" for="ix_type">Tipo</label>
                <select id="ix_type" class="field-select" name="type">
                  <option value="note">Nota</option>
                  <option value="call">Chiamata</option>
                  <option value="email">Email</option>
                  <option value="meeting">Incontro</option>
                  <option value="whatsapp">WhatsApp</option>
                </select>
              </div>
              <div class="field">
                <label class="field-label" for="ix_date">Data</label>
                <input id="ix_date" class="field-input" name="date" type="date" value={new Date().toISOString().slice(0, 10)} />
              </div>
              <div class="field">
                <label class="field-label" for="ix_subject">Oggetto</label>
                <input id="ix_subject" class="field-input" name="subject" type="text" placeholder="es. Prima visita" />
              </div>
            </div>
            <div class="field" style="margin-top:10px">
              <label class="field-label" for="ix_body">Nota</label>
              <textarea id="ix_body" class="field-textarea" name="body" rows={2} placeholder="Descrizione dell'interazione…"></textarea>
            </div>
            <div class="form-actions-sm">
              <button type="submit" class="btn btn-primary btn-sm">+ Aggiungi</button>
            </div>
          </form>
        </SectionCard>
      </div>

      <!-- Task -->
      <div id="tasks">
        <SectionCard title={`Task (${tasks.length})`}>
          {tasks.length > 0 && (
            <div class="task-list">
              {tasks.map(t => (
                <div class="task-item">
                  <span class:list={['badge', TASK_PRIORITY_BADGE[t.priority ?? ''] ?? 'badge-neutral']}>
                    {PRIORITY_LABELS[t.priority ?? ''] ?? t.priority}
                  </span>
                  <span class="task-title">{t.title}</span>
                  <span class="task-due">{fmtDate(t.due_date)}</span>
                  <span class:list={['badge', TASK_STATUS_BADGE[t.status ?? ''] ?? 'badge-neutral']}>
                    {TASK_STATUS_LABELS[t.status ?? ''] ?? t.status}
                  </span>
                </div>
              ))}
            </div>
          )}

          <form method="POST" class="inline-form">
            <input type="hidden" name="_action" value="add_task" />
            <p class="inline-form-title">Nuovo task</p>
            <div class="task-form-grid">
              <div class="field">
                <label class="field-label" for="tk_title">Titolo <span class="required">*</span></label>
                <input id="tk_title" class="field-input" name="title" required type="text" placeholder="es. Richiama cliente" />
              </div>
              <div class="field">
                <label class="field-label" for="tk_due">Scadenza</label>
                <input id="tk_due" class="field-input" name="due_date" type="date" />
              </div>
              <div class="field">
                <label class="field-label" for="tk_priority">Priorità</label>
                <select id="tk_priority" class="field-select" name="priority">
                  <option value="low">Bassa</option>
                  <option value="medium" selected>Media</option>
                  <option value="high">Alta</option>
                </select>
              </div>
              <div class="field">
                <label class="field-label" for="tk_status">Stato</label>
                <select id="tk_status" class="field-select" name="status">
                  <option value="todo" selected>Da fare</option>
                  <option value="in_progress">In corso</option>
                  <option value="done">Fatto</option>
                </select>
              </div>
            </div>
            <div class="form-actions-sm">
              <button type="submit" class="btn btn-primary btn-sm">+ Aggiungi</button>
            </div>
          </form>
        </SectionCard>
      </div>

      <!-- Documenti -->
      <div id="documents">
        <SectionCard title={`Documenti (${documents.length})`}>
          {documents.length > 0 && (
            <div class="doc-list">
              {documents.map(doc => (
                <div class="doc-item">
                  <svg class="doc-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                  </svg>
                  <span class="doc-name">{doc.label ?? 'Documento'}</span>
                  <span class="doc-date">{fmtDate(doc.date_created)}</span>
                  <div class="doc-actions">
                    {doc.directus_file_id && (
                      <a
                        href={`${directusUrl}/assets/${doc.directus_file_id}?access_token=${token}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary btn-sm"
                      >Apri</a>
                    )}
                    <form method="POST" style="display:contents">
                      <input type="hidden" name="_action" value="delete_document" />
                      <input type="hidden" name="doc_id" value={doc.id} />
                      <input type="hidden" name="file_id" value={doc.directus_file_id ?? ''} />
                      <button
                        type="submit"
                        class="btn btn-ghost btn-sm btn-icon"
                        onclick="return confirm('Eliminare questo documento?')"
                        title="Elimina documento"
                        aria-label="Elimina documento"
                      >
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
                        </svg>
                      </button>
                    </form>
                  </div>
                </div>
              ))}
            </div>
          )}

          <form method="POST" enctype="multipart/form-data" class="inline-form">
            <input type="hidden" name="_action" value="upload_document" />
            <p class="inline-form-title">Carica documento</p>
            <div class="upload-grid">
              <div class="field">
                <label class="field-label" for="doc_label">Etichetta</label>
                <input id="doc_label" class="field-input" name="label" type="text" placeholder="es. Carta d'identità" />
              </div>
              <div class="field">
                <label class="field-label" for="doc_file">File <span class="required">*</span></label>
                <input id="doc_file" class="field-input" name="file" type="file" required style="height:auto;padding:6px 10px" />
              </div>
            </div>
            <div class="form-actions-sm">
              <button type="submit" class="btn btn-primary btn-sm">Carica</button>
            </div>
          </form>
        </SectionCard>
      </div>

    </>}

  </div>
</AdminLayout>

<style>
  /* Breadcrumb */
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .breadcrumb-back {
    font-size: 13px;
    color: var(--c-ink-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .breadcrumb-back:hover { color: var(--c-ink); }

  .breadcrumb-sep { color: var(--c-border-2); font-size: 16px; }

  /* KPI bar */
  .kpi-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  @media (max-width: 640px) {
    .kpi-bar { grid-template-columns: repeat(2, 1fr); }
  }

  .kpi-item {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .kpi-val {
