---
// src/pages/admin/contacts/[id].astro
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import SectionCard from '@/components/admin/SectionCard.astro'
import type { Contact, Order, CrmInteraction, CrmTask, CustomerKpi } from '@/lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/admin/contacts')

const isNew = id === 'new'

const directusUrl = process.env.DIRECTUS_URL ?? ''
const token = Astro.cookies.get('admin_token')?.value ?? ''

async function dFetch(path: string, opts?: RequestInit) {
  try {
    const res = await fetch(`${directusUrl}${path}`, {
      ...opts,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json', ...((opts?.headers as Record<string, string>) ?? {}) },
    })
    if (!res.ok) return null
    return res.json()
  } catch { return null }
}

let saveError: string | null = null

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const action = formData.get('_action') ?? 'contact'

  if (action === 'upload_document') {
    const file = formData.get('file') as File | null
    if (file && file.size > 0) {
      const label = (formData.get('label') as string) || file.name
      const uploadForm = new FormData()
      uploadForm.append('file', file, file.name)
      uploadForm.append('title', label)
      const uploadRes = await fetch(`${directusUrl}/files`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: uploadForm,
      }).catch(() => null)
      if (uploadRes?.ok) {
        const { data: fd } = await uploadRes.json() as { data: { id: string } }
        await dFetch('/items/contact_documents', {
          method: 'POST',
          body: JSON.stringify({ contact_id: id, directus_file_id: fd.id, label }),
        })
      }
    }
    return Astro.redirect(`/admin/contacts/${id}#documents`)
  }

  if (action === 'delete_document') {
    const docId = formData.get('doc_id') as string
    const fileId = formData.get('file_id') as string
    if (docId) await dFetch(`/items/contact_documents/${docId}`, { method: 'DELETE' })
    if (fileId) await dFetch(`/files/${fileId}`, { method: 'DELETE' })
    return Astro.redirect(`/admin/contacts/${id}#documents`)
  }

  if (action === 'add_interaction') {
    const payload = {
      contact_id: id,
      type: formData.get('type') ?? 'note',
      date: formData.get('date') || new Date().toISOString(),
      subject: formData.get('subject') || null,
      body: formData.get('body') || null,
      outcome: formData.get('outcome') || null,
    }
    await dFetch('/items/crm_interactions', { method: 'POST', body: JSON.stringify(payload) })
    return Astro.redirect(`/admin/contacts/${id}#crm`)
  }

  if (action === 'add_task') {
    const payload = {
      contact_id: id,
      title: formData.get('title'),
      due_date: formData.get('due_date') || null,
      status: formData.get('status') ?? 'todo',
      priority: formData.get('priority') ?? 'medium',
      notes: formData.get('notes') || null,
    }
    await dFetch('/items/crm_tasks', { method: 'POST', body: JSON.stringify(payload) })
    return Astro.redirect(`/admin/contacts/${id}#tasks`)
  }

  const payload = {
    first_name: formData.get('first_name'),
    last_name: formData.get('last_name'),
    email: formData.get('email') || null,
    phone: formData.get('phone') || null,
    date_of_birth: formData.get('date_of_birth') || null,
    pipeline_stage: formData.get('pipeline_stage') ?? 'lead',
    canale_prevalente: formData.get('canale_prevalente') ?? 'offline',
    channel_type: formData.get('channel_type') ?? 'offline',
    is_active: formData.get('is_active') === 'true',
  }
  if (isNew) {
    const result = await dFetch('/items/contacts', { method: 'POST', body: JSON.stringify(payload) })
    if (result?.data?.id) {
      return Astro.redirect(`/admin/contacts/${result.data.id}?saved=1`)
    } else {
      saveError = 'Errore durante la creazione.'
    }
  } else {
    const result = await dFetch(`/items/contacts/${id}`, { method: 'PATCH', body: JSON.stringify(payload) })
    if (result) {
      return Astro.redirect(`/admin/contacts/${id}?saved=1`)
    } else {
      saveError = 'Errore durante il salvataggio.'
    }
  }
}

type ContactDocument = {
  id: string
  label: string | null
  date_created: string | null
  directus_file_id: string | null
}

let contact: Contact | null = null
let orders: Partial<Order>[] = []
let interactions: Partial<CrmInteraction>[] = []
let tasks: Partial<CrmTask>[] = []
let kpi: Partial<CustomerKpi> | null = null
let documents: ContactDocument[] = []

if (!isNew) {
  const [contactRes, ordersRes, interactionsRes, tasksRes, kpiRes, docsRes] = await Promise.all([
    dFetch(`/items/contacts/${id}?fields[]=*`),
    dFetch(`/items/orders?filter[contact_id][_eq]=${id}&fields[]=id,status,total,date_created,channel&sort[]=-date_created&limit=20`),
    dFetch(`/items/crm_interactions?filter[contact_id][_eq]=${id}&fields[]=id,type,date,subject,body&sort[]=-date&limit=20`),
    dFetch(`/items/crm_tasks?filter[contact_id][_eq]=${id}&fields[]=id,title,due_date,status,priority&sort[]=due_date&limit=20`),
    dFetch(`/items/customer_kpis?filter[contact_id][_eq]=${id}&limit=1`),
    dFetch(`/items/contact_documents?filter[contact_id][_eq]=${id}&fields[]=id,label,date_created,directus_file_id&sort[]=-date_created&limit=50`),
  ])
  if (!contactRes?.data) return Astro.redirect('/admin/contacts')
  contact = contactRes.data as Contact
  orders = (ordersRes?.data ?? []) as Partial<Order>[]
  interactions = (interactionsRes?.data ?? []) as Partial<CrmInteraction>[]
  tasks = (tasksRes?.data ?? []) as Partial<CrmTask>[]
  kpi = (kpiRes?.data?.[0] ?? null) as Partial<CustomerKpi> | null
  documents = (docsRes?.data ?? []) as ContactDocument[]
}

const saved = Astro.url.searchParams.get('saved') === '1'
const fullName = isNew ? 'Nuovo contatto' : `${contact?.first_name ?? ''} ${contact?.last_name ?? ''}`.trim()

const PIPELINE_LABELS: Record<string, string> = {
  lead: 'Lead', prospect: 'Prospect', cliente_attivo: 'Attivo',
  cliente_fidelizzato: 'Fidelizzato', inattivo: 'Inattivo',
}
const ORDER_STATUS_LABELS: Record<string, string> = {
  pending: 'In attesa', paid: 'Pagato', shipped: 'Spedito',
  delivered: 'Consegnato', refunded: 'Rimborsato',
}
const ORDER_STATUS_COLORS: Record<string, string> = {
  pending: 'background:#fef9c3;color:#ca8a04',
  paid: 'background:#eff6ff;color:#3b82f6',
  shipped: 'background:#fdf4ff;color:#a855f7',
  delivered: 'background:#f0fdf4;color:#22c55e',
  refunded: 'background:#f3f4f6;color:#6b7280',
}
const TASK_PRIORITY_COLORS: Record<string, string> = {
  high: 'color:#dc2626', medium: 'color:#f97316', low: 'color:#6b7280',
}

function fmtDate(iso: string | null | undefined) {
  if (!iso) return '—'
  return new Date(iso).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit', year: '2-digit' })
}

function toDateInput(iso: string | null | undefined): string {
  if (!iso) return ''
  return iso.slice(0, 10)
}
---

<AdminLayout title={fullName} active="contacts">

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap">
    <a href="/admin/contacts" style="color:#6b7280;text-decoration:none;font-size:13px">← Contatti</a>
    <span style="color:#d1d5db">/</span>
    <h1 style="font-size:18px;font-weight:700;color:#111827">{fullName}</h1>
    {!isNew && contact && <span style={`padding:3px 10px;border-radius:10px;font-size:12px;${
      contact.pipeline_stage === 'cliente_attivo' ? 'background:#f0fdf4;color:#22c55e' :
      contact.pipeline_stage === 'lead' ? 'background:#fff7ed;color:#f97316' :
      'background:#f3f4f6;color:#6b7280'
    }`}>{PIPELINE_LABELS[contact.pipeline_stage] ?? contact.pipeline_stage}</span>}
  </div>

  {saved && <p style="background:#f0fdf4;color:#22c55e;border:1px solid #bbf7d0;border-radius:6px;padding:10px 14px;font-size:13px;margin-bottom:16px">✓ Salvato con successo.</p>}
  {saveError && <p style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;border-radius:6px;padding:10px 14px;font-size:13px;margin-bottom:16px">{saveError}</p>}

  <div style="display:flex;flex-direction:column;gap:16px">

    <!-- KPI bar — edit mode only -->
    {!isNew && kpi && (
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px">
        <SectionCard>
          <div style="text-align:center">
            <div style="font-size:22px;font-weight:700;color:#111827">€{(kpi.clv ?? 0).toFixed(0)}</div>
            <div style="font-size:11px;color:#6b7280;margin-top:2px">Valore cliente</div>
          </div>
        </SectionCard>
        <SectionCard>
          <div style="text-align:center">
            <div style="font-size:22px;font-weight:700;color:#111827">{(kpi.total_orders_online ?? 0) + (kpi.total_orders_offline ?? 0)}</div>
            <div style="font-size:11px;color:#6b7280;margin-top:2px">Ordini totali</div>
          </div>
        </SectionCard>
        <SectionCard>
          <div style="text-align:center">
            <div style="font-size:22px;font-weight:700;color:#111827">€{((kpi.total_spent_online ?? 0) + (kpi.total_spent_offline ?? 0)).toFixed(0)}</div>
            <div style="font-size:11px;color:#6b7280;margin-top:2px">Totale speso</div>
          </div>
        </SectionCard>
        <SectionCard>
          <div style="text-align:center">
            <div style="font-size:22px;font-weight:700;color:#111827">{fmtDate(kpi.last_purchase_at)}</div>
            <div style="font-size:11px;color:#6b7280;margin-top:2px">Ultimo acquisto</div>
          </div>
        </SectionCard>
      </div>
    )}

    <!-- Anagrafica form — both create and edit -->
    <form method="POST">
      <SectionCard title="Anagrafica">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Nome *</label>
            <input name="first_name" required value={contact?.first_name ?? ''}
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;box-sizing:border-box" />
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Cognome *</label>
            <input name="last_name" required value={contact?.last_name ?? ''}
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;box-sizing:border-box" />
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Email</label>
            <input name="email" type="email" value={contact?.email ?? ''}
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;box-sizing:border-box" />
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Telefono</label>
            <input name="phone" type="tel" value={contact?.phone ?? ''}
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;box-sizing:border-box" />
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Data di nascita</label>
            <input name="date_of_birth" type="date" value={toDateInput(contact?.date_of_birth)}
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;box-sizing:border-box" />
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Stage pipeline</label>
            <select name="pipeline_stage"
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;background:#fff;box-sizing:border-box">
              <option value="lead" selected={!contact || contact.pipeline_stage === 'lead'}>Lead</option>
              <option value="prospect" selected={contact?.pipeline_stage === 'prospect'}>Prospect</option>
              <option value="cliente_attivo" selected={contact?.pipeline_stage === 'cliente_attivo'}>Attivo</option>
              <option value="cliente_fidelizzato" selected={contact?.pipeline_stage === 'cliente_fidelizzato'}>Fidelizzato</option>
              <option value="inattivo" selected={contact?.pipeline_stage === 'inattivo'}>Inattivo</option>
            </select>
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Canale prevalente</label>
            <select name="canale_prevalente"
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;background:#fff;box-sizing:border-box">
              <option value="offline" selected={!contact || contact.canale_prevalente === 'offline'}>Offline</option>
              <option value="online" selected={contact?.canale_prevalente === 'online'}>Online</option>
            </select>
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Tipo canale</label>
            <select name="channel_type"
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;background:#fff;box-sizing:border-box">
              <option value="offline" selected={!contact || contact.channel_type === 'offline'}>Offline</option>
              <option value="online" selected={contact?.channel_type === 'online'}>Online</option>
              <option value="both" selected={contact?.channel_type === 'both'}>Entrambi</option>
            </select>
          </div>

          <div>
            <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Stato</label>
            <select name="is_active"
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:8px 12px;font-size:14px;color:#111827;background:#fff;box-sizing:border-box">
              <option value="true" selected={contact?.is_active ?? true}>Attivo</option>
              <option value="false" selected={contact ? !contact.is_active : false}>Inattivo</option>
            </select>
          </div>

          {!isNew && contact?.stripe_customer_id && (
            <div>
              <label style="display:block;font-size:13px;font-weight:500;color:#374151;margin-bottom:4px">Stripe ID</label>
              <code style="display:block;font-size:12px;color:#6b7280;padding:9px 12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px">{contact.stripe_customer_id}</code>
            </div>
          )}

        </div>
      </SectionCard>

      <div style="display:flex;justify-content:flex-end;margin-top:16px">
        <button type="submit"
          style="background:#111827;color:#fff;border:none;padding:10px 24px;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer">
          {isNew ? 'Crea contatto' : 'Salva'}
        </button>
      </div>
    </form>

    <!-- CRM sections — edit mode only -->
    {!isNew && contact && <>

      <SectionCard title={`Ordini (${orders.length})`}>
        {orders.length === 0
          ? <p style="color:#9ca3af;font-size:14px">Nessun ordine.</p>
          : (
            <table style="width:100%;border-collapse:collapse;font-size:14px">
              <thead>
                <tr style="border-bottom:1px solid #e5e7eb">
                  <th style="text-align:left;padding:6px 8px;color:#6b7280;font-size:11px;font-weight:600;text-transform:uppercase">ID</th>
                  <th style="text-align:left;padding:6px 8px;color:#6b7280;font-size:11px;font-weight:600;text-transform:uppercase">Stato</th>
                  <th style="text-align:right;padding:6px 8px;color:#6b7280;font-size:11px;font-weight:600;text-transform:uppercase">Totale</th>
                  <th style="text-align:left;padding:6px 8px;color:#6b7280;font-size:11px;font-weight:600;text-transform:uppercase">Data</th>
                  <th style="text-align:left;padding:6px 8px;color:#6b7280;font-size:11px;font-weight:600;text-transform:uppercase">Canale</th>
                  <th style="padding:6px 8px"></th>
                </tr>
              </thead>
              <tbody>
                {orders.map(o => (
                  <tr style="border-bottom:1px solid #f3f4f6">
                    <td style="padding:8px;font-family:monospace;font-size:12px;color:#6b7280">{String(o.id ?? '').slice(0, 8)}…</td>
                    <td style="padding:8px">
                      <span style={`${ORDER_STATUS_COLORS[o.status ?? ''] ?? 'background:#f3f4f6;color:#6b7280'};padding:2px 8px;border-radius:10px;font-size:12px`}>
                        {ORDER_STATUS_LABELS[o.status ?? ''] ?? o.status}
                      </span>
                    </td>
                    <td style="padding:8px;text-align:right;font-weight:500">€{(o.total ?? 0).toFixed(2)}</td>
                    <td style="padding:8px;color:#6b7280">{fmtDate(o.date_created)}</td>
                    <td style="padding:8px;color:#6b7280">{o.channel ?? '—'}</td>
                    <td style="padding:8px"><a href={`/admin/orders/${o.id}`} style="color:#9ca3af;text-decoration:none">→</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </SectionCard>

      <div id="crm">
      <SectionCard title={`Note CRM (${interactions.length})`}>
        {interactions.length > 0 && (
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px">
            {interactions.map(i => (
              <div style="border:1px solid #e5e7eb;border-radius:6px;padding:10px 12px">
                <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px">
                  <span style="font-size:12px;font-weight:600;color:#374151;text-transform:uppercase">{i.type}</span>
                  <span style="color:#9ca3af;font-size:12px">{fmtDate(i.date)}</span>
                  {i.subject && <span style="font-size:13px;color:#111827;font-weight:500">{i.subject}</span>}
                </div>
                <p style="font-size:13px;color:#6b7280;margin:0">{i.body}</p>
              </div>
            ))}
          </div>
        )}
        <form method="POST" style="border-top:1px solid #f3f4f6;padding-top:14px">
          <input type="hidden" name="_action" value="add_interaction" />
          <p style="font-size:12px;font-weight:600;color:#6b7280;margin:0 0 10px;text-transform:uppercase">Nuova interazione</p>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px">
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Tipo</label>
              <select name="type" style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;background:#fff;color:#111827;box-sizing:border-box">
                <option value="note">Nota</option>
                <option value="call">Chiamata</option>
                <option value="email">Email</option>
                <option value="meeting">Incontro</option>
                <option value="whatsapp">WhatsApp</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Data</label>
              <input name="date" type="date" value={new Date().toISOString().slice(0,10)}
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box" />
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Oggetto</label>
              <input name="subject" type="text" placeholder="es. Prima visita"
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box" />
            </div>
          </div>
          <div style="margin-bottom:10px">
            <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Nota</label>
            <textarea name="body" rows={2} placeholder="Descrizione dell'interazione…"
              style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box;resize:vertical"></textarea>
          </div>
          <div style="display:flex;justify-content:flex-end">
            <button type="submit" style="background:#111827;color:#fff;border:none;padding:6px 18px;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer">
              + Aggiungi
            </button>
          </div>
        </form>
      </SectionCard>
      </div>

      <div id="tasks">
      <SectionCard title={`Task (${tasks.length})`}>
        {tasks.length > 0 && (
          <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px">
            {tasks.map(t => (
              <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid #f3f4f6">
                <span style={`font-size:11px;font-weight:700;${TASK_PRIORITY_COLORS[t.priority ?? ''] ?? 'color:#6b7280'}`}>
                  {(t.priority ?? '').toUpperCase()}
                </span>
                <span style="flex:1;font-size:14px;color:#111827">{t.title}</span>
                <span style="font-size:12px;color:#6b7280">{fmtDate(t.due_date)}</span>
                <span style={`font-size:12px;padding:1px 6px;border-radius:8px;${
                  t.status === 'done' ? 'background:#f0fdf4;color:#22c55e' :
                  t.status === 'in_progress' ? 'background:#eff6ff;color:#3b82f6' :
                  'background:#f3f4f6;color:#6b7280'
                }`}>{t.status}</span>
              </div>
            ))}
          </div>
        )}
        <form method="POST" style="border-top:1px solid #f3f4f6;padding-top:14px">
          <input type="hidden" name="_action" value="add_task" />
          <p style="font-size:12px;font-weight:600;color:#6b7280;margin:0 0 10px;text-transform:uppercase">Nuovo task</p>
          <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px;margin-bottom:10px">
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Titolo *</label>
              <input name="title" required type="text" placeholder="es. Richiama cliente"
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box" />
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Scadenza</label>
              <input name="due_date" type="date"
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box" />
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Priorità</label>
              <select name="priority" style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;background:#fff;color:#111827;box-sizing:border-box">
                <option value="low">Bassa</option>
                <option value="medium" selected>Media</option>
                <option value="high">Alta</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Stato</label>
              <select name="status" style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;background:#fff;color:#111827;box-sizing:border-box">
                <option value="todo" selected>Da fare</option>
                <option value="in_progress">In corso</option>
                <option value="done">Fatto</option>
              </select>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end">
            <button type="submit" style="background:#111827;color:#fff;border:none;padding:6px 18px;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer">
              + Aggiungi
            </button>
          </div>
        </form>
      </SectionCard>
      </div>

      <div id="documents">
      <SectionCard title={`Documenti (${documents.length})`}>
        {documents.length > 0 && (
          <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px">
            {documents.map(doc => (
              <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid #e5e7eb;border-radius:6px">
                <span style="font-size:18px">📄</span>
                <span style="flex:1;font-size:14px;color:#111827;font-weight:500">{doc.label ?? 'Documento'}</span>
                <span style="font-size:12px;color:#9ca3af">{fmtDate(doc.date_created)}</span>
                {doc.directus_file_id && (
                  <a
                    href={`${directusUrl}/assets/${doc.directus_file_id}?access_token=${token}`}
                    target="_blank"
                    style="font-size:12px;color:#3b82f6;text-decoration:none;padding:3px 10px;border:1px solid #bfdbfe;border-radius:4px"
                  >Apri</a>
                )}
                <form method="POST" style="margin:0">
                  <input type="hidden" name="_action" value="delete_document" />
                  <input type="hidden" name="doc_id" value={doc.id} />
                  <input type="hidden" name="file_id" value={doc.directus_file_id ?? ''} />
                  <button type="submit"
                    onclick="return confirm('Eliminare questo documento?')"
                    style="background:none;border:none;cursor:pointer;color:#dc2626;font-size:18px;line-height:1;padding:2px 4px"
                    title="Elimina">×</button>
                </form>
              </div>
            ))}
          </div>
        )}
        <form method="POST" enctype="multipart/form-data" style="border-top:1px solid #f3f4f6;padding-top:14px">
          <input type="hidden" name="_action" value="upload_document" />
          <p style="font-size:12px;font-weight:600;color:#6b7280;margin:0 0 10px;text-transform:uppercase">Carica documento</p>
          <div style="display:grid;grid-template-columns:1fr 2fr;gap:10px;margin-bottom:10px">
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">Etichetta</label>
              <input name="label" type="text" placeholder="es. Carta d'identità"
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:6px 10px;font-size:13px;color:#111827;box-sizing:border-box" />
            </div>
            <div>
              <label style="display:block;font-size:12px;font-weight:500;color:#374151;margin-bottom:3px">File *</label>
              <input name="file" type="file" required
                style="width:100%;border:1px solid #d1d5db;border-radius:6px;padding:5px 10px;font-size:13px;color:#111827;background:#fff;box-sizing:border-box" />
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end">
            <button type="submit" style="background:#111827;color:#fff;border:none;padding:6px 18px;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer">
              Carica
            </button>
          </div>
        </form>
      </SectionCard>
      </div>

    </>}

  </div>
</AdminLayout>
