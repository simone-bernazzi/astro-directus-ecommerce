---
// src/pages/account/indirizzi.astro — SSR: saved shipping addresses
export const prerender = false

import Base from '@/layouts/Base.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'

const token = Astro.cookies.get('directus_token')?.value
if (!token) return Astro.redirect('/login?redirect=/account/indirizzi')
---

<Base title="I miei indirizzi">
  <Header />
  <main class="container py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Sidebar -->
      <nav class="space-y-1">
        {[
          { href: '/account', label: 'Profilo' },
          { href: '/account/ordini', label: 'I miei ordini' },
          { href: '/account/indirizzi', label: 'Indirizzi' },
          { href: '/account/wishlist', label: 'Lista desideri' },
        ].map(link => (
          <a
            href={link.href}
            class:list={[
              'block px-4 py-2 rounded-md text-sm font-medium transition-colors',
              Astro.url.pathname === link.href
                ? 'bg-[var(--color-brand)] text-white'
                : 'text-[var(--color-text)] hover:bg-[var(--color-surface)]',
            ]}
          >
            {link.label}
          </a>
        ))}
        <button id="logout-btn" class="block w-full text-left px-4 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 transition-colors">
          Esci
        </button>
      </nav>

      <!-- Content -->
      <div class="md:col-span-3 space-y-6">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">I miei indirizzi</h1>
          <button id="show-add-form" class="text-sm px-4 py-2 bg-[var(--color-brand)] text-white rounded-md hover:opacity-90 transition-opacity">
            + Nuovo indirizzo
          </button>
        </div>

        <!-- Address list -->
        <div id="address-list" class="space-y-3">
          <p class="text-[var(--color-muted)] text-sm">Caricamento…</p>
        </div>

        <!-- Add form (hidden initially) -->
        <div id="add-form-wrap" class="hidden bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg p-6">
          <h2 class="font-semibold mb-5">Nuovo indirizzo</h2>
          <form id="add-address-form" class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <div class="sm:col-span-2">
              <label class="block text-sm font-medium mb-1" for="addr-label">Etichetta</label>
              <input id="addr-label" name="label" type="text" placeholder="Casa, Ufficio…" value="Casa"
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-sm font-medium mb-1" for="addr-name">Nome destinatario *</label>
              <input id="addr-name" name="name" type="text" required
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-sm font-medium mb-1" for="addr-line1">Via/Piazza *</label>
              <input id="addr-line1" name="line1" type="text" required
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div>
              <label class="block text-sm font-medium mb-1" for="addr-city">Città *</label>
              <input id="addr-city" name="city" type="text" required
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div>
              <label class="block text-sm font-medium mb-1" for="addr-postal">CAP *</label>
              <input id="addr-postal" name="postal_code" type="text" required
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div>
              <label class="block text-sm font-medium mb-1" for="addr-state">Provincia</label>
              <input id="addr-state" name="state" type="text"
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div>
              <label class="block text-sm font-medium mb-1" for="addr-country">Paese *</label>
              <input id="addr-country" name="country" type="text" required value="Italia"
                class="w-full px-3 py-2 border border-[var(--color-border)] rounded-md bg-[var(--color-bg)] text-sm focus:outline-none focus:ring-1 focus:ring-[var(--color-brand)]" />
            </div>

            <div class="sm:col-span-2 flex items-center gap-2">
              <input id="addr-default" name="is_default" type="checkbox" class="rounded" />
              <label for="addr-default" class="text-sm">Imposta come indirizzo predefinito</label>
            </div>

            <p id="add-error" class="sm:col-span-2 hidden text-sm text-red-600"></p>

            <div class="sm:col-span-2 flex gap-3">
              <button type="submit" id="add-submit" class="px-5 py-2 bg-[var(--color-brand)] text-white text-sm font-medium rounded-md hover:opacity-90 transition-opacity">
                Salva indirizzo
              </button>
              <button type="button" id="cancel-add" class="px-5 py-2 border border-[var(--color-border)] text-sm rounded-md hover:bg-[var(--color-surface)] transition-colors">
                Annulla
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  interface Address {
    id: string; label: string; name: string; line1: string; line2: string | null
    city: string; postal_code: string; state: string | null; country: string; is_default: boolean
  }

  const list = document.getElementById('address-list')!
  const showAddBtn = document.getElementById('show-add-form')!
  const formWrap = document.getElementById('add-form-wrap')!
  const cancelBtn = document.getElementById('cancel-add')!
  const form = document.getElementById('add-address-form') as HTMLFormElement
  const addError = document.getElementById('add-error')!
  const addSubmit = document.getElementById('add-submit') as HTMLButtonElement

  // ── Render addresses ────────────────────────────────────────────────────────
  function renderAddresses(addresses: Address[]) {
    if (addresses.length === 0) {
      list.innerHTML = '<p class="text-[var(--color-muted)] text-sm">Nessun indirizzo salvato. Aggiungine uno!</p>'
      return
    }

    list.innerHTML = addresses.map(a => `
      <div class="relative bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg p-5 ${a.is_default ? 'ring-2 ring-[var(--color-brand)]' : ''}">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-semibold text-sm">${a.label}</span>
              ${a.is_default ? '<span class="text-xs bg-[var(--color-brand)] text-white px-2 py-0.5 rounded-full">Predefinito</span>' : ''}
            </div>
            <p class="text-sm">${a.name}</p>
            <p class="text-sm text-[var(--color-muted)]">${a.line1}${a.line2 ? ', ' + a.line2 : ''}</p>
            <p class="text-sm text-[var(--color-muted)]">${a.postal_code} ${a.city}${a.state ? ' (' + a.state + ')' : ''}, ${a.country}</p>
          </div>
          <div class="flex gap-2 shrink-0">
            ${!a.is_default ? `<button type="button" class="set-default-btn text-xs text-[var(--color-muted)] hover:text-[var(--color-brand)] transition-colors" data-id="${a.id}">Predefinito</button>` : ''}
            <button type="button" class="delete-btn text-xs text-[var(--color-muted)] hover:text-red-500 transition-colors" data-id="${a.id}">Elimina</button>
          </div>
        </div>
      </div>
    `).join('')

    list.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Eliminare questo indirizzo?')) return
        await fetch(`/api/account/addresses?id=${btn.dataset.id}`, { method: 'DELETE' })
        loadAddresses()
      })
    })

    list.querySelectorAll<HTMLButtonElement>('.set-default-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        await fetch(`/api/account/addresses?id=${btn.dataset.id}&default=true`, { method: 'PATCH' })
        loadAddresses()
      })
    })
  }

  async function loadAddresses() {
    try {
      const res = await fetch('/api/account/addresses')
      if (!res.ok) { list.innerHTML = '<p class="text-red-500 text-sm">Errore nel caricamento.</p>'; return }
      const { addresses } = await res.json() as { addresses: Address[] }
      renderAddresses(addresses)
    } catch {
      list.innerHTML = '<p class="text-red-500 text-sm">Errore di rete.</p>'
    }
  }

  loadAddresses()

  // ── Add form logic ──────────────────────────────────────────────────────────
  showAddBtn.addEventListener('click', () => formWrap.classList.remove('hidden'))
  cancelBtn.addEventListener('click', () => { formWrap.classList.add('hidden'); form.reset() })

  form.addEventListener('submit', async e => {
    e.preventDefault()
    addError.classList.add('hidden')
    addSubmit.disabled = true
    addSubmit.textContent = 'Salvataggio…'

    const fd = new FormData(form)
    const body = {
      label: fd.get('label') as string || 'Casa',
      name: fd.get('name') as string,
      line1: fd.get('line1') as string,
      line2: null,
      city: fd.get('city') as string,
      postal_code: fd.get('postal_code') as string,
      state: (fd.get('state') as string) || null,
      country: fd.get('country') as string,
      is_default: (document.getElementById('addr-default') as HTMLInputElement).checked,
    }

    try {
      const res = await fetch('/api/account/addresses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      })
      const data = await res.json()
      if (res.ok) {
        form.reset()
        formWrap.classList.add('hidden')
        loadAddresses()
      } else {
        addError.textContent = data.error ?? 'Errore durante il salvataggio.'
        addError.classList.remove('hidden')
      }
    } catch {
      addError.textContent = 'Errore di rete. Riprova.'
      addError.classList.remove('hidden')
    }

    addSubmit.disabled = false
    addSubmit.textContent = 'Salva indirizzo'
  })

  // ── Logout ──────────────────────────────────────────────────────────────────
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' }).catch(() => {})
    window.location.href = '/'
  })
</script>
