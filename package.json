{
  "name": "astro-directus-ecommerce",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "node scripts/backup.mjs",
    "backup:weekly": "node scripts/backup.mjs --type weekly",
    "backup:monthly": "node scripts/backup.mjs --type monthly",
    "restore": "node scripts/restore.mjs",
    "migrate": "node scripts/migrate.mjs",
    "setup": "node scripts/setup-collections.mjs",
    "setup:crm": "node scripts/setup-crm-collections.mjs",
    "setup:forms": "node scripts/setup-forms-collections.mjs",
    "setup:all": "node scripts/setup-collections.mjs && node scripts/setup-crm-collections.mjs && node scripts/setup-forms-collections.mjs",
    "kpis": "npx tsx scripts/calculate-kpis.mjs",
    "kpis:contact": "npx tsx scripts/calculate-kpis.mjs --contact-id=",
    "claude": "bash scripts/claude.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.0",
    "@astrojs/sitemap": "^3.7.2",
    "@directus/sdk": "^21.2.2",
    "@nanostores/persistent": "^0.10.2",
    "astro": "^6.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "nanostores": "^0.11.3",
    "stripe": "^17.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
