# ── Directus ─────────────────────────────────────────────────────────────────
DIRECTUS_URL=https://cms.tuodominio.it
DIRECTUS_TOKEN=your_directus_static_token

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Tag Manager container ID (es. GTM-XXXXXXX). Lascia vuoto per disabilitare.
PUBLIC_GTM_ID=GTM-XXXXXXX

# ── App ───────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://tuodominio.it
ALLOWED_ORIGIN=https://tuodominio.it
DEFAULT_LOCALE=it

# ── Email (opzionale) ─────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Indirizzo mittente per le email transazionali (es. noreply@tuodominio.it)
SMTP_FROM=noreply@tuodominio.it
# Nome visualizzato come mittente nelle email
SMTP_FROM_NAME="Il mio negozio"
CONTACT_EMAIL_TO=info@tuodominio.it

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────────────
# Ottieni le chiavi su https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Score minimo accettato (0.0–1.0). Google consiglia 0.5
RECAPTCHA_MIN_SCORE=0.5

# ── Geo IP ───────────────────────────────────────────────────────────────────
# Provider per il rilevamento del paese dal IP del visitatore
# Opzioni: 'ip-api' (default, gratuito), 'maxmind' (self-hosted), 'cloudflare' (CDN header)
GEO_PROVIDER=ip-api
# Percorso al database MaxMind GeoLite2 (richiesto solo se GEO_PROVIDER=maxmind)
MAXMIND_DB_PATH=./GeoLite2-Country.mmdb

# ── Admin ─────────────────────────────────────────────────────────────────────
# Chiave usata per: login pagina /admin, endpoint /api/admin/* (notify-shipped, notify-restock)
ADMIN_KEY=your_random_admin_secret
# Soglia stock per gli alert nel dashboard (default: 5)
ADMIN_LOW_STOCK_THRESHOLD=5
# Chiave segreta per proteggere l'endpoint /api/internal/run-kpis (usata dai Directus Flows)
INTERNAL_SECRET=your_random_internal_secret

# ── Backup ────────────────────────────────────────────────────────────────────
# Chiave segreta per proteggere l'endpoint /api/admin/backup
BACKUP_ADMIN_KEY=your_random_secret_key

# Tipo di storage: 'local' (default) oppure 's3'
BACKUP_STORAGE=local
# Percorso locale dove salvare i backup (relativo alla root del progetto)
BACKUP_LOCAL_PATH=./backups

# Cron expression per la Netlify Scheduled Function (default: @daily)
# Esempi: '@daily' | '@weekly' | '0 2 * * *'
BACKUP_CRON=@daily

# ── Deploy VPS (opzionale — richiesto solo per npm run deploy) ───────────────
# IP o hostname del server (es. 1.2.3.4 oppure vps.tuodominio.it)
DEPLOY_HOST=
# Utente SSH con accesso alla directory di deploy (default: deploy)
DEPLOY_USER=deploy
# Percorso assoluto della directory frontend sul server
DEPLOY_PATH=/var/www/nomeprogetto/frontend
# Nome del processo PM2 da riavviare dopo il deploy
DEPLOY_PM2_APP=nomeprogetto
# Porta su cui gira il frontend Node.js sul server.
# Ogni progetto su stesso VPS deve usare una porta diversa (es. 4321, 4322, 4323...).
# Deve corrispondere al PORT in ecosystem.config.cjs e al proxy_pass del vhost Nginx.
DEPLOY_PORT=4321

# ── Backup S3 (opzionale — richiesto solo se BACKUP_STORAGE=s3) ───────────────
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=backups/
